(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|key'?1_realified?1| Real) (|j'?2_realified?2| Real)
            (tr?3_realified?3 Real) (tr?4_realified?4 Real)
            (|i'?5_realified?5| Real) (K?6_realified?6 Real)
            (|i'?7_realified?7| Real) (j?8_realified?8 Real)
            (SIZE?9_realified?9 Real))
         (and (<= (+ (- j?8_realified?8) 1) 0) (<= (- SIZE?9_realified?9) 0)
                (<= (+ (- SIZE?9_realified?9) j?8_realified?8 1) 0)
                (= (+ (- |i'?5_realified?5|) (- K?6_realified?6)
                        j?8_realified?8 -1) 0)
                (or (and (= K?6_realified?6 0)
                           (= (+ (- |i'?5_realified?5|) j?8_realified?8 -1) 0))
                      (and (<= (+ (- K?6_realified?6) 1) 0)
                             (<= (+ (- j?8_realified?8) 1) 0)
                             (<= (+ (- |i'?5_realified?5|) -1) 0)))
                (<= (- K?6_realified?6) 0)
                (or (<= (+ |i'?5_realified?5| 1) 0)
                      (and (<= (- |i'?5_realified?5|) 0)
                             (<= (+ (- tr?4_realified?4) tr?3_realified?3) 0)))
                (= (+ |key'?1_realified?1| (- tr?4_realified?4)) 0)
                (= (+ |j'?2_realified?2| (- j?8_realified?8) -1) 0)
                (= (+ |i'?7_realified?7| (- |i'?5_realified?5|)) 0)
                (= (+ term_to_project_onto2 (- |key'?1_realified?1|)) 0)
                (= (+ term_to_project_onto1 (- |j'?2_realified?2|)) 0)
                (= (+ term_to_project_onto0 (- |i'?7_realified?7|)) 0)
                (= (+ term_to_project_onto (- SIZE?9_realified?9)) 0))))
(check-sat)