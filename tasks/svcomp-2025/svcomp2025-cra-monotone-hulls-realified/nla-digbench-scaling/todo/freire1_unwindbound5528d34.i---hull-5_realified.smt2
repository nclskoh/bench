(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((uninterp?1_realified?1 Real) (|tmp'?2_realified?2| Real)
            (|x'?3?3| Real) (|r'?4_realified?4| Real)
            (|counter'?5_realified?5| Real) (r?6_realified?6 Real)
            (x?7?7 Real) (counter?8_realified?8 Real) (a?9?9 Real))
         (and (<= (- r?6_realified?6) 0) (<= (+ counter?8_realified?8 -4) 0)
                (= (+ (* 2 x?7?7) (- a?9?9) uninterp?1_realified?1
                        (- r?6_realified?6)) 0)
                (< (+ (- x?7?7) r?6_realified?6) 0)
                (= (+ |tmp'?2_realified?2| (- counter?8_realified?8)) 0)
                (= (+ |x'?3?3| (- x?7?7) r?6_realified?6) 0)
                (= (+ |r'?4_realified?4| (- r?6_realified?6) -1) 0)
                (= (+ |counter'?5_realified?5| (- counter?8_realified?8) -1) 0)
                (<= (- uninterp?1_realified?1) 0)
                (= (+ term_to_project_onto3 (- |tmp'?2_realified?2|)) 0)
                (= (+ term_to_project_onto2 (- |x'?3?3|)) 0)
                (= (+ term_to_project_onto1 (- |r'?4_realified?4|)) 0)
                (= (+ term_to_project_onto0 (- |counter'?5_realified?5|)) 0)
                (= (+ term_to_project_onto (- a?9?9)) 0))))