            (i?5_realified?5 Real) (k?6_realified?6 Real)
            (remainder_realified?7 Real) (remainder_realified?8 Real)
            (quotient_realified?9 Real) (quotient_realified?10 Real))
         (and (<= (- n?4_realified?4) 0) (<= (- i?5_realified?5) 0)
                (<= (+ (* -2 k?6_realified?6) i?5_realified?5 1) 0)
                (or (and (or (< (ite (and (<= (- i?5_realified?5) 0)
