(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((uninterp?1_realified?1 Real) (|c'?2_realified?2| Real)
            (|x'?3_realified?3| Real) (|y'?4_realified?4| Real)
            (c?5_realified?5 Real) (k?6_realified?6 Real)
            (x?7_realified?7 Real) (y?8_realified?8 Real))
         (and (<= (- c?5_realified?5) 0) (<= (- x?7_realified?7) 0)
                (<= (- y?8_realified?8) 0)
                (= (+ y?8_realified?8 (- c?5_realified?5)) 0)
                (= (+ uninterp?1_realified?1 y?8_realified?8
                        (* -2 x?7_realified?7)) 0)
                (<= (+ (- k?6_realified?6) c?5_realified?5 1) 0)
                (= (+ |c'?2_realified?2| (- c?5_realified?5) -1) 0)
                (= (+ |x'?3_realified?3| (- y?8_realified?8)
                        (- x?7_realified?7) -1) 0)
                (= (+ |y'?4_realified?4| (- y?8_realified?8) -1) 0)
                (<= (- uninterp?1_realified?1) 0)
                (= (+ term_to_project_onto2 (- |c'?2_realified?2|)) 0)
                (= (+ term_to_project_onto1 (- |x'?3_realified?3|)) 0)
                (= (+ term_to_project_onto0 (- |y'?4_realified?4|)) 0)
                (= (+ term_to_project_onto (- k?6_realified?6)) 0))))
(check-sat)