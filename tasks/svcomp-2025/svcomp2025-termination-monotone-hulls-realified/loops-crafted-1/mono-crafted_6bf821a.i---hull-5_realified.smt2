(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|y'?1_realified?1| Real) (|x'?2_realified?2| Real)
            (phi_y?3_realified?3 Real) (phi_x?4_realified?4 Real)
            (phi_x?5_realified?5 Real) (y?6_realified?6 Real)
            (x?7_realified?7 Real))
         (and (<= (+ (- y?6_realified?6) 1) 0) (<= (- x?7_realified?7) 0)
                (<= (+ x?7_realified?7 -999999) 0)
                (or (and (<= (+ (- x?7_realified?7) 500000) 0)
                           (or (and (<= (+ (- x?7_realified?7) 750000) 0)
                                      (= (+ (- phi_x?5_realified?5)
                                              x?7_realified?7 2) 0))
                                 (and (<= (+ x?7_realified?7 -749999) 0)
                                        (= (+ (- phi_x?5_realified?5)
                                                x?7_realified?7 1) 0)))
                           (= (+ (- phi_x?4_realified?4) phi_x?5_realified?5) 0)
                           (= (+ (- phi_y?3_realified?3) y?6_realified?6 1) 0))
                      (and (<= (+ x?7_realified?7 -499999) 0)
                             (= (+ (- phi_x?4_realified?4) x?7_realified?7 1) 0)
                             (= (+ (- phi_y?3_realified?3) y?6_realified?6) 0)))
                (= (+ |y'?1_realified?1| (- phi_y?3_realified?3)) 0)
                (= (+ |x'?2_realified?2| (- phi_x?4_realified?4)) 0)
                (= (- (+ x?7_realified?7 (- |x'?2_realified?2|))) 0)
                (= (+ (+ y?6_realified?6 (- |y'?1_realified?1|))
                        (- (+ x?7_realified?7 (- |x'?2_realified?2|)))) 0)
                (= (+ term_to_project_onto0 (- x?7_realified?7)) 0)
                (= (+ term_to_project_onto (- y?6_realified?6)) 0))))
(check-sat)