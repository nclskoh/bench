(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(assert (exists
         ((|tmp'?1| Int) (|loop_entered'?2| Int) (tr?3 Int) (tr?4 Int)
            (phi_tmp?5 Int) (phi_tmp?6 Int) (|index2'?7| Int)
            (|index1'?8| Int) (loop_entered?9 Int) (index2?10 Int)
            (index1?11 Int))
         (and (<= (- loop_entered?9) 0) (<= (- index2?10) 0)
                (<= (- index1?11) 0) (<= (+ index1?11 (- index2?10) 1) 0)
                (or (and (<= (+ index1?11 -99999) 0)
                           (or (and (<= (+ (- index2?10) 100000) 0)
                                      (= (- phi_tmp?6) 0))
                                 (and (<= (+ index2?10 -99999) 0)
                                        (= (+ (- phi_tmp?6) 1) 0)))
                           (= (+ (- phi_tmp?5) phi_tmp?6) 0))
                      (and (<= (+ (- index1?11) 100000) 0)
                             (= (- phi_tmp?5) 0)))
                (or (< phi_tmp?5 0) (< 0 phi_tmp?5)) (= (+ (- tr?3) tr?4) 0)
                (= (+ |tmp'?1| (- phi_tmp?5)) 0)
                (= (+ |loop_entered'?2| -1) 0)
                (= (+ |index2'?7| (- index2?10) 1) 0)
                (= (+ |index1'?8| (- index1?11) -1) 0)
                (= term_to_project_onto2 |tmp'?1|)
                (= term_to_project_onto1 |loop_entered'?2|)
                (= term_to_project_onto0 |index2'?7|)
                (= term_to_project_onto |index1'?8|))))
(check-sat)
