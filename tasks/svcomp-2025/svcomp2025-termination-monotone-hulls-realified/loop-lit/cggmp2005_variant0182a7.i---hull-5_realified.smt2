(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|hi'?1_realified?1| Real) (|mid'?2_realified?2| Real)
            (|lo'?3_realified?3| Real) (hi?4_realified?4 Real)
            (lo?5_realified?5 Real) (mid?6_realified?6 Real))
         (and (<= (+ (- hi?4_realified?4) 1) 0) (<= (- lo?5_realified?5) 0)
                (<= (- mid?6_realified?6) 0)
                (= (+ (* 2 mid?6_realified?6) lo?5_realified?5
                        (- hi?4_realified?4)) 0)
                (<= (+ (- mid?6_realified?6) 1) 0)
                (= (+ |hi'?1_realified?1| (- hi?4_realified?4) 1) 0)
                (= (+ |mid'?2_realified?2| (- mid?6_realified?6) 1) 0)
                (= (+ |lo'?3_realified?3| (- lo?5_realified?5) -1) 0)
                (= (+ mid?6_realified?6 (- |mid'?2_realified?2|)) 0)
                (= (+ (+ hi?4_realified?4 (- |hi'?1_realified?1|))
                        (- (+ mid?6_realified?6 (- |mid'?2_realified?2|)))) 0)
                (= (+ term_to_project_onto1 (- lo?5_realified?5)) 0)
                (= (+ term_to_project_onto0 (- mid?6_realified?6)) 0)
                (= (+ term_to_project_onto (- hi?4_realified?4)) 0))))
(check-sat)