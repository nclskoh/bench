(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|j'?1_realified?1| Real) (|k'?2_realified?2| Real)
            (j?3_realified?3 Real) (k?4_realified?4 Real)
            (n?5_realified?5 Real) (remainder_realified?6 Real)
            (remainder_realified?7 Real) (quotient_realified?8 Real)
            (quotient_realified?9 Real))
         (and (<= (- j?3_realified?3) 0) (<= (- k?4_realified?4) 0)
                (<= (- n?5_realified?5) 0)
                (<= (+ 3
                         (ite (and (<= (- n?5_realified?5) 0)
                                     (<= (- n?5_realified?5) 0))
                              remainder_realified?6 (- remainder_realified?7))
                         (- n?5_realified?5) (* 3 j?3_realified?3)) 0)
                (<= (+ (- k?4_realified?4) 1) 0)
                (= (+ |j'?1_realified?1| (- j?3_realified?3) -1) 0)
                (= (+ |k'?2_realified?2| (- k?4_realified?4) 1) 0)
                (= (+ k?4_realified?4 (- |k'?2_realified?2|)) 0)
                (= (+ (+ j?3_realified?3 (- |j'?1_realified?1|))
                        (+ k?4_realified?4 (- |k'?2_realified?2|))) 0)
                (= (+ (+ n?5_realified?5 (- n?5_realified?5))
                        (* -3 (+ j?3_realified?3 (- |j'?1_realified?1|)))) 0)
                (= (+ n?5_realified?5 (- n?5_realified?5)) 0)
                (= (+ term_to_project_onto1 (- k?4_realified?4)) 0)
                (= (+ term_to_project_onto0 (- j?3_realified?3)) 0)
                (= (+ term_to_project_onto (- n?5_realified?5)) 0)
                (= (- n?5_realified?5) (+ (* 3 quotient_realified?9)
                                            remainder_realified?7))
                (<= 0 remainder_realified?7)
                (or (<= remainder_realified?7 (+ 3 -1))
                      (<= remainder_realified?7 (+ -3 -1)))
                (= n?5_realified?5 (+ (* 3 quotient_realified?8)
                                        remainder_realified?6))
                (<= 0 remainder_realified?6)
                (or (<= remainder_realified?6 (+ 3 -1))
                      (<= remainder_realified?6 (+ -3 -1))))))