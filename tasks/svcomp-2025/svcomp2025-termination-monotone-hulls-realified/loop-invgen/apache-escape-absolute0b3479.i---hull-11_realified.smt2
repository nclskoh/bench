(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|tmp'?1_realified?1| Real) (havoc?2_realified?2 Real)
            (|cp'?3_realified?3| Real) (cp?4_realified?4 Real)
            (urilen?5_realified?5 Real))
         (and (<= (+ (- cp?4_realified?4) 1) 0)
                (<= (+ (- urilen?5_realified?5) 1) 0)
                (or (<= (+ (- urilen?5_realified?5) cp?4_realified?4 2) 0)
                      (<= (+ urilen?5_realified?5 (- cp?4_realified?4)) 0))
                (= havoc?2_realified?2 0)
                (<= (+ (- urilen?5_realified?5) cp?4_realified?4 1) 0)
                (<= (- cp?4_realified?4) 0)
                (= (+ |tmp'?1_realified?1| (- havoc?2_realified?2)) 0)
                (= (+ |cp'?3_realified?3| (- cp?4_realified?4) -1) 0)
                (= (+ term_to_project_onto1 (- |tmp'?1_realified?1|)) 0)
                (= (+ term_to_project_onto0 (- |cp'?3_realified?3|)) 0)
                (= (+ term_to_project_onto (- urilen?5_realified?5)) 0))))
(check-sat)