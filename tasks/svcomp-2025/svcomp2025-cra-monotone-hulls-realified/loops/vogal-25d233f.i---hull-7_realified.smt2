(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|i'?1_realified?1| Real) (|cont_aux'?2_realified?2| Real)
            (|j'?3_realified?3| Real) (K?4_realified?4 Real)
            (tr?5_realified?5 Real) (tr?6_realified?6 Real)
            (|cont_aux'?7_realified?7| Real) (|j'?8_realified?8| Real)
            (cont_aux?9_realified?9 Real) (j?10_realified?10 Real)
            (i?11_realified?11 Real))
         (and (<= (- cont_aux?9_realified?9) 0) (<= (- i?11_realified?11) 0)
                (or (<= (+ tr?6_realified?6 1) 0)
                      (<= (+ (- tr?5_realified?5) 1) 0))
                (= (+ (- |j'?3_realified?3|) K?4_realified?4) 0)
                (<= (+ |cont_aux'?2_realified?2| (- K?4_realified?4)
                         (- cont_aux?9_realified?9)) 0)
                (<= (+ (- |cont_aux'?2_realified?2|) cont_aux?9_realified?9) 0)
                (or (and (= K?4_realified?4 0)
                           (= (+ (- |cont_aux'?2_realified?2|)
                                   cont_aux?9_realified?9) 0)
                           (= (- |j'?3_realified?3|) 0))
                      (and (<= (+ (- K?4_realified?4) 1) 0)
                             (<= (- cont_aux?9_realified?9) 0)
                             (<= (+ |j'?3_realified?3| -10) 0)
                             (<= (- |cont_aux'?2_realified?2|) 0)
                             (<= (+ (- |j'?3_realified?3|) 1) 0)))
                (<= (- K?4_realified?4) 0)
                (<= (- |cont_aux'?2_realified?2|) 0)
                (<= (- |j'?3_realified?3|) 0)
                (<= (+ (- |j'?3_realified?3|) 10) 0)
                (= (+ |cont_aux'?7_realified?7| (- |cont_aux'?2_realified?2|)) 0)
                (= (+ |j'?8_realified?8| (- |j'?3_realified?3|)) 0)
                (= (+ |i'?1_realified?1| (- i?11_realified?11) -1) 0)
                (= (+ term_to_project_onto1
                        (- (+ |i'?1_realified?1| (- i?11_realified?11)))) 0)
                (= (+ term_to_project_onto0
                        (- (+ |j'?8_realified?8| (- j?10_realified?10)))) 0)
                (= (+ term_to_project_onto
                        (- (+ |cont_aux'?7_realified?7|
                                (- cont_aux?9_realified?9)))) 0))))
