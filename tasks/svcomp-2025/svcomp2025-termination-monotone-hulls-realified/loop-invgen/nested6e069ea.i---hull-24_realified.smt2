                (or (and (= K?5_realified?5 0)
                           (= (+ (- |tmp'?3_realified?3|) tmp?9_realified?9) 0)
                           (= (+ (- |k'?2_realified?2|) k?12_realified?12) 0)
                           (= (+ (- |j'?4_realified?4|)
                                   (* 2 i?11_realified?11)) 0))
                      (and (<= (+ (- K?5_realified?5) 1) 0)
                             (<= (- i?11_realified?11) 0)
                             (<= (- i?11_realified?11) 0)
                             (<= (+ (- n?13_realified?13)
                                      (* 2 i?11_realified?11) 1) 0)
                             (= (+ |k'?2_realified?2| (- n?13_realified?13)) 0)
                             (<= (+ (- |j'?4_realified?4|) 1) 0)
                             (<= (- i?11_realified?11) 0)
                             (<= (+ |j'?4_realified?4| (- n?13_realified?13)) 0)))
                (<= (- K?5_realified?5) 0) (<= (- |j'?4_realified?4|) 0)
                (<= (- i?11_realified?11) 0)
                (<= (+ (- n?13_realified?13) 1) 0)
                (<= (+ (- |j'?4_realified?4|) n?13_realified?13) 0)
                (= (+ |tmp'?6_realified?6| (- |tmp'?3_realified?3|)) 0)
                (= (+ |k'?8_realified?8| (- |k'?2_realified?2|)) 0)
                (= (+ |j'?7_realified?7| (- |j'?4_realified?4|)) 0)
                (= (+ |i'?1_realified?1| (- i?11_realified?11) -1) 0)
                (= (+ term_to_project_onto2
                        (- (+ |i'?1_realified?1| (- i?11_realified?11)))) 0)
                (= (+ term_to_project_onto1
                        (- (+ |j'?7_realified?7| (- j?10_realified?10)))) 0)
                (= (+ term_to_project_onto0
                        (- (+ |k'?8_realified?8| (- k?12_realified?12)))) 0)
                (= (+ term_to_project_onto
                        (- (+ |tmp'?6_realified?6| (- tmp?9_realified?9)))) 0))))
