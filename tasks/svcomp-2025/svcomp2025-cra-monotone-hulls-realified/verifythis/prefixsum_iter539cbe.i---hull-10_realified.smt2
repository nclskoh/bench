(declare-const term_to_project_onto Real)
(assert (exists
         ((|x'?1_realified?1| Real) (x?2_realified?2 Real)
            (remainder_realified?3 Real) (remainder_realified?4 Real)
            (quotient_realified?5 Real) (quotient_realified?6 Real))
         (and (= (ite (and (<= (- x?2_realified?2) 0)
                             (<= (- x?2_realified?2) 0))
                      remainder_realified?3 (- remainder_realified?4)) 0)
                (<= (+ (- x?2_realified?2) 2) 0)
                (= (+ (* 2 |x'?1_realified?1|)
                        (ite (and (<= (- x?2_realified?2) 0)
                                    (<= (- x?2_realified?2) 0))
                             remainder_realified?3 (- remainder_realified?4))
                        (- x?2_realified?2)) 0)
                (= (+ term_to_project_onto (- |x'?1_realified?1|)) 0)
                (= (- x?2_realified?2) (+ (* 2 quotient_realified?6)
                                            remainder_realified?4))
                (<= 0 remainder_realified?4)
                (or (<= remainder_realified?4 (+ 2 -1))
                      (<= remainder_realified?4 (+ -2 -1)))
                (= x?2_realified?2 (+ (* 2 quotient_realified?5)
                                        remainder_realified?3))
                (<= 0 remainder_realified?3)
                (or (<= remainder_realified?3 (+ 2 -1))
                      (<= remainder_realified?3 (+ -2 -1))))))