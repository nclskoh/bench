                (= index?5_realified?5 (+ (* 2 quotient_realified?8)
                                            remainder_realified?6))
                (<= 0 remainder_realified?6)
                (or (<= remainder_realified?6 (+ 2 -1))
                      (<= remainder_realified?6 (+ -2 -1))))))