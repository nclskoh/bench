(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((uninterp?1_realified?1 Real) (uninterp?2_realified?2 Real)
            (|v'?3_realified?3| Real) (|r'?4_realified?4| Real)
            (u?5_realified?5 Real) (v?6_realified?6 Real)
            (r?7_realified?7 Real) (A?8_realified?8 Real))
         (and (<= (+ (- u?5_realified?5) 1) 0)
                (<= (+ (- v?6_realified?6) 1) 0)
                (<= (+ (- A?8_realified?8) 1) 0)
                (= (+ (- A?8_realified?8) 1) 0)
                (= (+ (* 4 r?7_realified?7) (* 4 A?8_realified?8)
                        uninterp?2_realified?2 (* -2 v?6_realified?6)
                        (- uninterp?1_realified?1) (* 2 u?5_realified?5)) 0)
                (<= (+ (- r?7_realified?7) 1) 0)
                (= (+ |r'?4_realified?4| (- r?7_realified?7) v?6_realified?6) 0)
                (= (+ |v'?3_realified?3| (- v?6_realified?6) -2) 0)
                (<= (+ 1 (- uninterp?1_realified?1)) 0)
                (<= (+ u?5_realified?5 (- uninterp?1_realified?1)) 0)
                (<= (+ u?5_realified?5 (- uninterp?1_realified?1)) 0)
                (<= (+ 1 (- uninterp?2_realified?2)) 0)
                (<= (+ v?6_realified?6 (- uninterp?2_realified?2)) 0)
                (<= (+ v?6_realified?6 (- uninterp?2_realified?2)) 0)
                (= (+ term_to_project_onto2
                        (- (+ v?6_realified?6 (- |v'?3_realified?3|)))) 0)
                (= (+ term_to_project_onto1
                        (- (+ r?7_realified?7 (- |r'?4_realified?4|)))) 0)
                (= (+ term_to_project_onto0
                        (- (+ A?8_realified?8 (- A?8_realified?8)))) 0)
                (= (+ term_to_project_onto
                        (- (+ u?5_realified?5 (- u?5_realified?5)))) 0))))
(check-sat)