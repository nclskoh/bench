(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|return@width'?1_realified?1| Real)
            (|return@pos'?2_realified?2| Real) (|return'?3_realified?3| Real)
            (|c'?4_realified?4| Real) (|x'?5_realified?5| Real)
            (type_err?6_realified?6 Real) (type_err?7_realified?7 Real)
            (havoc?8_realified?8 Real) (phi_return@width?9_realified?9 Real)
            (type_err?10_realified?10 Real)
            (phi_return@pos?11_realified?11 Real)
            (type_err?12_realified?12 Real) (phi_return?13_realified?13 Real)
            (havoc?14_realified?14 Real) (havoc?15_realified?15 Real)
            (return@width?16_realified?16 Real)
            (return@pos?17_realified?17 Real) (return?18_realified?18 Real)
            (c?19_realified?19 Real) (x?20_realified?20 Real))
         (and (<= (+ (- x?20_realified?20) 1) 0)
                (or (and (= havoc?15_realified?15 0)
                           (= (+ (- phi_return?13_realified?13)
                                   havoc?14_realified?14) 0)
                           (= (+ (- phi_return@pos?11_realified?11)
                                   type_err?12_realified?12) 0)
                           (= (+ (- phi_return@width?9_realified?9)
                                   type_err?10_realified?10) 0))
                      (and (or (< havoc?15_realified?15 0)
                                 (< (- havoc?15_realified?15) 0))
                             (= (+ havoc?8_realified?8
                                     (- phi_return?13_realified?13)) 0)
                             (= (+ type_err?7_realified?7
                                     (- phi_return@pos?11_realified?11)) 0)
                             (= (+ type_err?6_realified?6
                                     (- phi_return@width?9_realified?9)) 0)))
                (= (+ |return@width'?1_realified?1|
                        (- phi_return@width?9_realified?9)) 0)
                (= (+ |return@pos'?2_realified?2|
                        (- phi_return@pos?11_realified?11)) 0)
                (= (+ |return'?3_realified?3| (- phi_return?13_realified?13)) 0)
                (= (+ |c'?4_realified?4| (- havoc?15_realified?15)) 0)
                (= (+ |x'?5_realified?5| (- x?20_realified?20) 1) 0)
                (= (+ x?20_realified?20 (- |x'?5_realified?5|)) 0)
                (= (+ term_to_project_onto3 (- x?20_realified?20)) 0)
                (= (+ term_to_project_onto2 (- c?19_realified?19)) 0)
                (= (+ term_to_project_onto1 (- return?18_realified?18)) 0)
                (= (+ term_to_project_onto0 (- return@pos?17_realified?17)) 0)
                (= (+ term_to_project_onto (- return@width?16_realified?16)) 0))))
