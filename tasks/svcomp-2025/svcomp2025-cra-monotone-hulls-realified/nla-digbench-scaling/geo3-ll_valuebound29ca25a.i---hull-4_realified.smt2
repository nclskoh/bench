                (= (+ term_to_project_onto3 (- |x'?6_realified?6|)) 0)
                (= (+ term_to_project_onto2 (- az?9_realified?9)) 0)
                (= (+ term_to_project_onto1 (- k?10_realified?10)) 0)
                (= (+ term_to_project_onto0 (- a?11_realified?11)) 0)
                (= (+ term_to_project_onto (- z?12_realified?12)) 0))))
