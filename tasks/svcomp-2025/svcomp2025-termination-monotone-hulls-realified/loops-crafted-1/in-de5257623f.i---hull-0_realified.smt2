(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|z'?1_realified?1| Real) (|y'?2_realified?2| Real)
            (z?3_realified?3 Real) (y?4_realified?4 Real))
         (and (<= (- z?3_realified?3) 0) (<= (- y?4_realified?4) 0)
                (= (+ y?4_realified?4 (- z?3_realified?3)) 0)
                (<= (+ (- z?3_realified?3) 1) 0)
                (= (+ |z'?1_realified?1| (- z?3_realified?3) 1) 0)
                (= (+ |y'?2_realified?2| (- y?4_realified?4) 1) 0)
                (= (+ term_to_project_onto0 (- y?4_realified?4)) 0)
                (= (+ term_to_project_onto (- z?3_realified?3)) 0))))
(check-sat)