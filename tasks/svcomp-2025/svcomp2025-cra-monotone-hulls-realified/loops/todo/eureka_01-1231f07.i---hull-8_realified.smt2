(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|y'?1_realified?1| Real) (|x'?2_realified?2| Real)
            (tr?3_realified?3 Real) (tr?4_realified?4 Real)
            (tr?5_realified?5 Real) (tr?6_realified?6 Real)
            (tr?7_realified?7 Real) (|i'?8_realified?8| Real)
            (y?9_realified?9 Real) (x?10_realified?10 Real)
            (i?11_realified?11 Real) (edgecount?12_realified?12 Real))
         (and (<= (- i?11_realified?11) 0)
                (<= (- edgecount?12_realified?12) 0)
                (<= (+ (- edgecount?12_realified?12) i?11_realified?11 1) 0)
                (<= (+ (- tr?3_realified?3) (- tr?4_realified?4)
                         tr?5_realified?5) 0)
                (= (+ |i'?8_realified?8| (- i?11_realified?11) -1) 0)
                (= (+ (- tr?6_realified?6) |y'?1_realified?1|) 0)
                (= (+ (- tr?7_realified?7) |x'?2_realified?2|) 0)
                (= (+ term_to_project_onto2 (- y?9_realified?9)) 0)
                (= (+ term_to_project_onto1 (- x?10_realified?10)) 0)
                (= (+ term_to_project_onto0 (- i?11_realified?11)) 0)
                (= (+ term_to_project_onto (- edgecount?12_realified?12)) 0))))
(check-sat)