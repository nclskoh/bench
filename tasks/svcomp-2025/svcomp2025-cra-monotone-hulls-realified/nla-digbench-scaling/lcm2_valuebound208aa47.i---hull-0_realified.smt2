(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((uninterp?1_realified?1 Real) (uninterp?2_realified?2 Real)
            (uninterp?3_realified?3 Real) (|v'?4_realified?4| Real)
            (|u'?5_realified?5| Real) (|y'?6_realified?6| Real)
            (|x'?7_realified?7| Real) (phi_v?8_realified?8 Real)
            (phi_u?9_realified?9 Real) (phi_y?10_realified?10 Real)
            (phi_x?11_realified?11 Real) (x?12_realified?12 Real)
            (u?13_realified?13 Real) (y?14_realified?14 Real)
            (v?15_realified?15 Real) (b?16_realified?16 Real)
            (a?17_realified?17 Real))
         (and (<= (+ (- x?12_realified?12) 1) 0)
                (<= (+ (- u?13_realified?13) 1) 0)
                (<= (+ (- y?14_realified?14) 1) 0)
                (<= (+ (- v?15_realified?15) 1) 0)
                (<= (+ (- b?16_realified?16) 1) 0)
                (<= (+ (- a?17_realified?17) 1) 0)
                (= (+ (* -2 uninterp?3_realified?3) uninterp?2_realified?2
                        uninterp?1_realified?1) 0)
                (or (<= (+ (- y?14_realified?14) x?12_realified?12 1) 0)
                      (<= (+ y?14_realified?14 (- x?12_realified?12) 1) 0))
                (or (and (<= (+ (- y?14_realified?14) x?12_realified?12) 0)
                           (= (+ (- phi_x?11_realified?11) x?12_realified?12) 0)
                           (= (+ (- phi_y?10_realified?10) y?14_realified?14
                                   (- x?12_realified?12)) 0)
                           (= (+ (- phi_u?9_realified?9) v?15_realified?15
                                   u?13_realified?13) 0)
                           (= (+ (- phi_v?8_realified?8) v?15_realified?15) 0))
                      (and (<= (+ y?14_realified?14 (- x?12_realified?12) 1) 0)
                             (= (+ (- phi_x?11_realified?11)
                                     (- y?14_realified?14) x?12_realified?12) 0)
                             (= (+ (- phi_y?10_realified?10)
                                     y?14_realified?14) 0)
                             (= (+ (- phi_u?9_realified?9) u?13_realified?13) 0)
                             (= (+ (- phi_v?8_realified?8) v?15_realified?15
                                     u?13_realified?13) 0)))
                (= (+ |v'?4_realified?4| (- phi_v?8_realified?8)) 0)
                (= (+ |u'?5_realified?5| (- phi_u?9_realified?9)) 0)
                (= (+ |y'?6_realified?6| (- phi_y?10_realified?10)) 0)
                (= (+ |x'?7_realified?7| (- phi_x?11_realified?11)) 0)
                (<= (+ 1 (- uninterp?1_realified?1)) 0)
                (<= (+ x?12_realified?12 (- uninterp?1_realified?1)) 0)
                (<= (+ u?13_realified?13 (- uninterp?1_realified?1)) 0)
                (<= (+ 1 (- uninterp?2_realified?2)) 0)
                (<= (+ y?14_realified?14 (- uninterp?2_realified?2)) 0)
                (<= (+ v?15_realified?15 (- uninterp?2_realified?2)) 0)
                (<= (+ 1 (- uninterp?3_realified?3)) 0)
                (<= (+ b?16_realified?16 (- uninterp?3_realified?3)) 0)
                (<= (+ a?17_realified?17 (- uninterp?3_realified?3)) 0)
                (= (- (+ (* -2 uninterp?3_realified?3) uninterp?2_realified?2
                           uninterp?1_realified?1)) 0)
                (= (+ term_to_project_onto2
                        (- (+ |x'?7_realified?7| (- x?12_realified?12)))) 0)
                (= (+ term_to_project_onto1
                        (- (+ |y'?6_realified?6| (- y?14_realified?14)))) 0)
                (= (+ term_to_project_onto0
                        (- (+ |u'?5_realified?5| (- u?13_realified?13)))) 0)
                (= (+ term_to_project_onto
                        (- (+ |v'?4_realified?4| (- v?15_realified?15)))) 0))))
(check-sat)