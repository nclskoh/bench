(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|j'?1_realified?1| Real) (|i'?2_realified?2| Real)
            (n?3_realified?3 Real) (i?4_realified?4 Real)
            (j?5_realified?5 Real))
         (and (<= (- n?3_realified?3) 0) (<= (- i?4_realified?4) 0)
                (<= (- j?5_realified?5) 0)
                (<= (+ i?4_realified?4 (- n?3_realified?3)) 0)
                (= (+ |j'?1_realified?1| (- j?5_realified?5) -2) 0)
                (= (+ |i'?2_realified?2| (- i?4_realified?4) -1) 0)
                (= (+ (+ n?3_realified?3 (- n?3_realified?3))
                        (- (+ i?4_realified?4 (- |i'?2_realified?2|)))) 0)
                (= (+ n?3_realified?3 (- n?3_realified?3)) 0)
                (= (+ (* 2 (+ n?3_realified?3 (- n?3_realified?3)))
                        (+ j?5_realified?5 (- |j'?1_realified?1|))
                        (* -2 (+ i?4_realified?4 (- |i'?2_realified?2|)))) 0)
                (= (+ term_to_project_onto1 (- i?4_realified?4)) 0)
                (= (+ term_to_project_onto0 (- j?5_realified?5)) 0)
                (= (+ term_to_project_onto (- n?3_realified?3)) 0))))
(check-sat)