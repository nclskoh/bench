(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|w'?1?1| Real) (tr?2?2 Real) (|j'?3_realified?3| Real)
            (K?4_realified?4 Real) (|i'?5_realified?5| Real)
            (|j'?6_realified?6| Real) (|w'?7?7| Real) (w?8?8 Real)
            (j?9_realified?9 Real) (i?10_realified?10 Real)
            (n?11_realified?11 Real))
         (and (<= (+ (- i?10_realified?10) 1) 0)
                (<= (+ (- n?11_realified?11) i?10_realified?10) 0)
                (= (+ (- |j'?3_realified?3|) K?4_realified?4) 0)
                (or (and (= K?4_realified?4 0) (= (+ (- |w'?1?1|) tr?2?2) 0)
                           (= (- |j'?3_realified?3|) 0))
                      (and (<= (+ (- K?4_realified?4) 1) 0)
                             (<= (+ (- i?10_realified?10) 1) 0)
                             (<= (+ (- |j'?3_realified?3|) 1) 0)
                             (<= (+ |j'?3_realified?3| (- i?10_realified?10)) 0)))
                (<= (- K?4_realified?4) 0) (<= (- |j'?3_realified?3|) 0)
                (<= (+ (- i?10_realified?10) 1) 0)
                (<= (+ (- |j'?3_realified?3|) i?10_realified?10) 0)
                (= (+ |w'?7?7| (- |w'?1?1|)) 0)
                (= (+ |j'?6_realified?6| (- |j'?3_realified?3|)) 0)
                (= (+ |i'?5_realified?5| (- i?10_realified?10) -1) 0)
                (= (+ term_to_project_onto2 (- w?8?8)) 0)
                (= (+ term_to_project_onto1 (- j?9_realified?9)) 0)
                (= (+ term_to_project_onto0 (- i?10_realified?10)) 0)
                (= (+ term_to_project_onto (- n?11_realified?11)) 0))))
(check-sat)