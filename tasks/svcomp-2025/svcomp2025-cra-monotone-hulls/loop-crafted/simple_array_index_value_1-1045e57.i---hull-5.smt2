(declare-const term_to_project_onto Real)
(assert (exists
         ((|index'?1| Int) (tr?2 Int) (tr?3 Int) (tr?4 Int) (index?5 Int))
         (and (<= (- index?5) 0) (<= (+ index?5 -999) 0)
                (or (and (= (ite (and (<= (- index?5) 0) (<= 0 index?5))
                                 (mod index?5 2) (- (mod (- index?5) 2))) 0)
                           (= tr?4 0))
                      (and (or (< (ite (and (<= (- index?5) 0) (<= 0 index?5))
                                       (mod index?5 2)
                                       (- (mod (- index?5) 2))) 0)
                                 (< 0 (ite (and (<= (- index?5) 0)
                                                  (<= 0 index?5))
                                           (mod index?5 2)
                                           (- (mod (- index?5) 2)))))
                             (or (<= (+ tr?3 1) 0) (<= (+ (- tr?2) 1) 0))))
                (= (+ |index'?1| (- index?5) -1) 0)
                (= term_to_project_onto |index'?1|))))
(check-sat)
