(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(assert (exists
         ((|tmp'?1| Int) (|k'?2| Int) (|j'?3| Int) (|i'?4| Int)
            (phi_tmp?5 Int) (phi_tmp?6 Int) (phi_tmp?7 Int) (j?8 Int)
            (i?9 Int) (k?10 Int))
         (and (<= (+ (- i?9) 1) 0) (<= (+ i?9 -999999) 0)
                (or (and (<= (+ (- k?10) (- i?9) 1) 0)
                           (or (and (<= (+ k?10 i?9 -2) 0)
                                      (or (and (<= (+ i?9 1) 0)
                                                 (= (- phi_tmp?7) 0))
                                            (and (<= (- i?9) 0)
                                                   (= (+ (- phi_tmp?7) 1) 0)))
                                      (= (+ (- phi_tmp?6) phi_tmp?7) 0))
                                 (and (<= (+ (- k?10) (- i?9) 3) 0)
                                        (= (- phi_tmp?6) 0)))
                           (= (+ (- phi_tmp?5) phi_tmp?6) 0))
                      (and (<= (+ k?10 i?9) 0) (= (- phi_tmp?5) 0)))
                (or (< phi_tmp?5 0) (< 0 phi_tmp?5))
                (= (+ |tmp'?1| (- phi_tmp?5)) 0) (= (+ |k'?2| (- k?10) 1) 0)
                (= (+ (- j?8) |j'?3| (- k?10)) 0) (= (+ |i'?4| (- i?9) -1) 0)
                (= term_to_project_onto2 |tmp'?1|)
                (= term_to_project_onto1 |k'?2|)
                (= term_to_project_onto0 |j'?3|)
                (= term_to_project_onto |i'?4|))))
(check-sat)
