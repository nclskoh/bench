(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|z'?1_realified?1| Real) (|y'?2_realified?2| Real)
            (|x'?3_realified?3| Real) (z?4_realified?4 Real)
            (y?5_realified?5 Real) (x?6_realified?6 Real))
         (and (<= (- z?4_realified?4) 0) (<= (- x?6_realified?6) 0)
                (or (<= (+ x?6_realified?6 1) 0)
                      (<= (+ (- x?6_realified?6) 1) 0))
                (= (+ |z'?1_realified?1| (- z?4_realified?4) -1) 0)
                (= (+ (- y?5_realified?5) |y'?2_realified?2| 2) 0)
                (= (+ |x'?3_realified?3| (- x?6_realified?6) 1) 0)
                (= (+ term_to_project_onto1 (- z?4_realified?4)) 0)
                (= (+ term_to_project_onto0 (- y?5_realified?5)) 0)
                (= (+ term_to_project_onto (- x?6_realified?6)) 0))))
(check-sat)