(assert (exists ((|i'?1| Int) (|k'?2| Int) (k?3 Int) (i?4 Int) (n?5 Int))
         (and (<= (- i?4) 0) (= (+ (* -2 k?3) (* 2 n?5) (- i?4)) 0)
                (<= (+ (- n?5) i?4 1) 0) (= (+ |k'?2| (- k?3) 1) 0)
