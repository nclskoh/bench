(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|key'?1_realified?1| Real) (|j'?2_realified?2| Real)
            (tr?3_realified?3 Real) (tr?4_realified?4 Real)
            (|i'?5_realified?5| Real) (K?6_realified?6 Real)
            (|i'?7_realified?7| Real) (key?8_realified?8 Real)
            (i?9_realified?9 Real) (j?10_realified?10 Real)
            (SIZE?11_realified?11 Real))
         (and (<= (+ (- j?10_realified?10) 1) 0)
                (<= (- SIZE?11_realified?11) 0)
                (<= (+ (- SIZE?11_realified?11) j?10_realified?10 1) 0)
                (= (+ (- |i'?5_realified?5|) (- K?6_realified?6)
                        j?10_realified?10 -1) 0)
                (or (and (= K?6_realified?6 0)
                           (= (+ (- |i'?5_realified?5|) j?10_realified?10 -1) 0))
                      (and (<= (+ (- K?6_realified?6) 1) 0)
                             (<= (+ (- j?10_realified?10) 1) 0)
                             (<= (+ (- |i'?5_realified?5|) -1) 0)))
                (<= (- K?6_realified?6) 0)
                (or (<= (+ |i'?5_realified?5| 1) 0)
                      (and (<= (- |i'?5_realified?5|) 0)
                             (<= (+ (- tr?4_realified?4) tr?3_realified?3) 0)))
                (= (+ |key'?1_realified?1| (- tr?4_realified?4)) 0)
                (= (+ |j'?2_realified?2| (- j?10_realified?10) -1) 0)
                (= (+ |i'?7_realified?7| (- |i'?5_realified?5|)) 0)
                (= (+ term_to_project_onto1
                        (- (+ |i'?7_realified?7| (- i?9_realified?9)))) 0)
                (= (+ term_to_project_onto0
                        (- (+ |j'?2_realified?2| (- j?10_realified?10)))) 0)
                (= (+ term_to_project_onto
                        (- (+ |key'?1_realified?1| (- key?8_realified?8)))) 0))))
(check-sat)