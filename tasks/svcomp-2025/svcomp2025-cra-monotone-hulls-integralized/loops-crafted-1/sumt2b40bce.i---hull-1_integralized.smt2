                               (< (- (ite (and (<= (- l?8?8) 0)
                                                 (<= (- l?8?8) 0))
                                          remainder?10 (- remainder?11))) 0))
                           (= (+ (- phi_i?5?5) i?6?6) 0)
                           (= (+ (- phi_j?4?4) j?7?7 1) 0))
                      (and (= (ite (and (<= (- l?8?8) 0) (<= (- l?8?8) 0))
                                   remainder?10 (- remainder?11)) 0)
                             (= (+ (- phi_i?5?5) i?6?6 1) 0)
                             (= (+ (- phi_j?4?4) j?7?7) 0)))
                (= (+ |l'?1?1| (- l?8?8) -1) 0)
                (= (+ |j'?2?2| (- phi_j?4?4)) 0)
                (= (+ |i'?3?3| (- phi_i?5?5)) 0)
                (= (+ term_to_project_onto1_integralized
                        (- (+ |i'?3?3| (- i?6?6)))) 0)
                (= (+ term_to_project_onto0_integralized
                        (- (+ |j'?2?2| (- j?7?7)))) 0)
                (= (+ term_to_project_onto_integralized
                        (- (+ |l'?1?1| (- l?8?8)))) 0)
                (= (- l?8?8) (+ (* 2 quotient?13) remainder?11))
                (<= 0 remainder?11)
                (or (<= remainder?11 (+ 2 -1)) (<= remainder?11 (+ -2 -1)))
                (= l?8?8 (+ (* 2 quotient?12) remainder?10))
                (<= 0 remainder?10)
                (or (<= remainder?10 (+ 2 -1)) (<= remainder?10 (+ -2 -1))))))
