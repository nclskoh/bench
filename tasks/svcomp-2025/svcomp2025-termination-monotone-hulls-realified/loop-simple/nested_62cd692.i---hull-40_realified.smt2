(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|c'?1_realified?1| Real) (|e'?2_realified?2| Real)
            (|f'?3_realified?3| Real) (|d'?4_realified?4| Real)
            (K?5_realified?5 Real) (|d'?6_realified?6| Real)
            (|e'?7_realified?7| Real) (|f'?8_realified?8| Real)
            (f?9_realified?9 Real) (e?10_realified?10 Real)
            (d?11_realified?11 Real) (c?12_realified?12 Real))
         (and (<= (+ (- f?9_realified?9) 1) 0)
                (<= (+ (- e?10_realified?10) 1) 0)
                (<= (+ (- d?11_realified?11) 1) 0)
                (<= (- c?12_realified?12) 0) (<= (+ c?12_realified?12 -5) 0)
                (= (+ (- |d'?4_realified?4|) K?5_realified?5) 0)
                (<= (+ |f'?3_realified?3| (* -5 K?5_realified?5)
                         (- f?9_realified?9)) 0)
                (<= (+ |e'?2_realified?2| (* -5 K?5_realified?5)
                         (- e?10_realified?10)) 0)
                (or (and (= K?5_realified?5 0)
                           (= (+ (- |f'?3_realified?3|) f?9_realified?9) 0)
                           (= (+ (- |e'?2_realified?2|) e?10_realified?10) 0)
                           (= (- |d'?4_realified?4|) 0))
                      (and (<= (+ (- K?5_realified?5) 1) 0)
                             (<= (+ (- f?9_realified?9) 1) 0)
                             (<= (+ (- e?10_realified?10) 1) 0)
                             (= (+ |e'?2_realified?2| -6) 0)
                             (= (+ |f'?3_realified?3| -6) 0)
                             (<= (+ |d'?4_realified?4| -6) 0)
                             (<= (+ (- |d'?4_realified?4|) 1) 0)))
                (<= (- K?5_realified?5) 0)
                (<= (+ (- |f'?3_realified?3|) 1) 0)
                (<= (+ (- |e'?2_realified?2|) 1) 0)
                (<= (- |d'?4_realified?4|) 0)
                (<= (+ (- |d'?4_realified?4|) 6) 0)
                (= (+ |f'?8_realified?8| (- |f'?3_realified?3|)) 0)
                (= (+ |e'?7_realified?7| (- |e'?2_realified?2|)) 0)
                (= (+ |d'?6_realified?6| (- |d'?4_realified?4|)) 0)
                (= (+ |c'?1_realified?1| (- c?12_realified?12) -1) 0)
                (= (+ term_to_project_onto2 (- |c'?1_realified?1|)) 0)
                (= (+ term_to_project_onto1 (- |d'?6_realified?6|)) 0)
                (= (+ term_to_project_onto0 (- |e'?7_realified?7|)) 0)
                (= (+ term_to_project_onto (- |f'?8_realified?8|)) 0))))
