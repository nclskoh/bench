(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|x'?1_realified?1| Real) (|z'?2_realified?2| Real)
            (|v'?3_realified?3| Real) (|y'?4_realified?4| Real)
            (K?5_realified?5 Real) (|y'?6_realified?6| Real)
            (|z'?7_realified?7| Real) (|v'?8_realified?8| Real)
            (v?9_realified?9 Real) (z?10_realified?10 Real)
            (y?11_realified?11 Real) (x?12_realified?12 Real))
         (and (<= (- v?9_realified?9) 0) (<= (- z?10_realified?10) 0)
                (<= (- y?11_realified?11) 0) (<= (- x?12_realified?12) 0)
                (<= (+ x?12_realified?12 -9) 0)
                (= (+ (- |y'?4_realified?4|) K?5_realified?5) 0)
                (<= (+ |v'?3_realified?3| (* -10 K?5_realified?5)
                         (- v?9_realified?9)) 0)
                (<= (+ |z'?2_realified?2| (* -10 K?5_realified?5)
                         (- z?10_realified?10)) 0)
                (or (and (= K?5_realified?5 0)
                           (= (+ (- |v'?3_realified?3|) v?9_realified?9) 0)
                           (= (+ (- |z'?2_realified?2|) z?10_realified?10) 0)
                           (= (- |y'?4_realified?4|) 0))
                      (and (<= (+ (- K?5_realified?5) 1) 0)
                             (<= (- v?9_realified?9) 0)
                             (<= (- z?10_realified?10) 0)
                             (= (+ |z'?2_realified?2| -10) 0)
                             (= (+ |v'?3_realified?3| -10) 0)
                             (<= (+ |y'?4_realified?4| -10) 0)
                             (<= (+ (- |y'?4_realified?4|) 1) 0)))
                (<= (- K?5_realified?5) 0) (<= (- |v'?3_realified?3|) 0)
                (<= (- |z'?2_realified?2|) 0) (<= (- |y'?4_realified?4|) 0)
                (<= (+ (- |y'?4_realified?4|) 10) 0)
                (= (+ |v'?8_realified?8| (- |v'?3_realified?3|)) 0)
                (= (+ |z'?7_realified?7| (- |z'?2_realified?2|)) 0)
                (= (+ |y'?6_realified?6| (- |y'?4_realified?4|)) 0)
                (= (+ |x'?1_realified?1| (- x?12_realified?12) -1) 0)
                (= (+ term_to_project_onto2
                        (- (+ |x'?1_realified?1| (- x?12_realified?12)))) 0)
                (= (+ term_to_project_onto1
                        (- (+ |y'?6_realified?6| (- y?11_realified?11)))) 0)
                (= (+ term_to_project_onto0
                        (- (+ |z'?7_realified?7| (- z?10_realified?10)))) 0)
                (= (+ term_to_project_onto
                        (- (+ |v'?8_realified?8| (- v?9_realified?9)))) 0))))
(check-sat)