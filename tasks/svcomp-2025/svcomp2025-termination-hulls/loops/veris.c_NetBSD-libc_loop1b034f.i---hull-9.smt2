(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|p@width'?1| Int) (|p@pos'?2| Int) (|p'?3| Int) (pathlim?4 Int)
            (p?5 Int) (p@pos?6 Int) (p@width?7 Int) (tmp?8 Int))
         (and (<= (+ (- pathlim?4) p?5) 0) (<= (+ (- tmp?8) p?5) 0)
                (= (+ (- p@width?7) |p@width'?1|) 0)
                (= (+ (- p@pos?6) |p@pos'?2| -4) 0)
                (= (+ |p'?3| (- p?5) -4) 0)
                (= term_to_project_onto3 (+ p?5 (- |p'?3|)))
                (= term_to_project_onto2 (+ p@pos?6 (- |p@pos'?2|)))
                (= term_to_project_onto1 (+ p@width?7 (- |p@width'?1|)))
                (= term_to_project_onto0 (+ tmp?8 (- tmp?8)))
                (= term_to_project_onto (+ pathlim?4 (- pathlim?4))))))
