(declare-const term_to_project_onto_integralized Int)
(declare-const term_to_project_onto1_integralized Int)
(declare-const term_to_project_onto0_integralized Int)
(assert (exists
         ((|l'?1?1| Int) (|j'?2?2| Int) (|i'?3?3| Int) (phi_j?4?4 Int)
            (phi_i?5?5 Int) (i?6?6 Int) (j?7?7 Int) (l?8?8 Int) (n?9?9 Int)
            (remainder?10 Int) (remainder?11 Int) (quotient?12 Int)
            (quotient?13 Int))
         (and (<= (- i?6?6) 0) (<= (- j?7?7) 0) (<= (- l?8?8) 0)
                (<= (- n?9?9) 0) (= (+ l?8?8 (- j?7?7) (- i?6?6)) 0)
                (<= (+ (- n?9?9) l?8?8 1) 0)
                (or (and (or (< (ite (and (<= (- l?8?8) 0) (<= (- l?8?8) 0))
