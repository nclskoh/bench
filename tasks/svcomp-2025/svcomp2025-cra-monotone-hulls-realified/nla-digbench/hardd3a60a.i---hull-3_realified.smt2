(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto4 Real)
(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(assert (exists
         ((uninterp?1_realified?1 Real) (|p'?2_realified?2| Real)
            (|d'?3_realified?3| Real) (p?4_realified?4 Real)
            (d?5_realified?5 Real) (r?6_realified?6 Real)
            (q?7_realified?7 Real) (A?8_realified?8 Real)
            (B?9_realified?9 Real))
         (and (<= (+ (- p?4_realified?4) 1) 0)
                (<= (+ (- d?5_realified?5) 1) 0) (= q?7_realified?7 0)
                (<= (+ (- B?9_realified?9) 1) 0)
                (= (+ (- r?6_realified?6) A?8_realified?8) 0)
                (= q?7_realified?7 0) (= q?7_realified?7 0)
                (= (+ r?6_realified?6 (- A?8_realified?8)) 0)
                (= (+ d?5_realified?5 (- uninterp?1_realified?1)) 0)
                (<= (+ (- r?6_realified?6) d?5_realified?5) 0)
                (= (+ |p'?2_realified?2| (* -2 p?4_realified?4)) 0)
                (= (+ |d'?3_realified?3| (* -2 d?5_realified?5)) 0)
                (<= (+ 1 (- uninterp?1_realified?1)) 0)
                (<= (+ p?4_realified?4 (- uninterp?1_realified?1)) 0)
                (<= (+ B?9_realified?9 (- uninterp?1_realified?1)) 0)
                (= (+ term_to_project_onto4 (- p?4_realified?4)) 0)
                (= (+ term_to_project_onto3 (- d?5_realified?5)) 0)
                (= (+ term_to_project_onto2 (- r?6_realified?6)) 0)
                (= (+ term_to_project_onto1 (- q?7_realified?7)) 0)
                (= (+ term_to_project_onto0 (- A?8_realified?8)) 0)
                (= (+ term_to_project_onto (- B?9_realified?9)) 0))))
(check-sat)