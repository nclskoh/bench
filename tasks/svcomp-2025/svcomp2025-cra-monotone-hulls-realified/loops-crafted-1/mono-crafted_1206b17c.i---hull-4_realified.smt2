(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|z'?1_realified?1| Real) (|x'?2_realified?2| Real)
            (phi_z?3_realified?3 Real) (z?4_realified?4 Real)
            (y?5_realified?5 Real) (x?6_realified?6 Real))
         (and (<= (- z?4_realified?4) 0) (<= (+ (- y?5_realified?5) 1) 0)
                (<= (- x?6_realified?6) 0)
                (= (+ (- y?5_realified?5) 10000000) 0)
                (<= (+ x?6_realified?6 (- y?5_realified?5) 1) 0)
                (or (and (<= (+ x?6_realified?6 -4999999) 0)
                           (= (+ (- phi_z?3_realified?3) z?4_realified?4) 0))
                      (and (<= (+ (- x?6_realified?6) 5000000) 0)
                             (= (+ (- phi_z?3_realified?3) z?4_realified?4 2) 0)))
                (= (+ |z'?1_realified?1| (- phi_z?3_realified?3)) 0)
                (= (+ |x'?2_realified?2| (- x?6_realified?6) -1) 0)
                (= (+ term_to_project_onto1 (- |z'?1_realified?1|)) 0)
                (= (+ term_to_project_onto0 (- |x'?2_realified?2|)) 0)
                (= (+ term_to_project_onto (- y?5_realified?5)) 0))))
(check-sat)