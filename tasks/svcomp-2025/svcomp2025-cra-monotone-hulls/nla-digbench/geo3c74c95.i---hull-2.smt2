(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto4 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto3 Real)
(assert (exists
         ((uninterp?1 Int) (uninterp?2 Int) (uninterp?3 Int) (|c'?4| Int)
            (|y'?5| Int) (|x'?6| Int) (c?7 Int) (k?8 Int) (x?9 Int)
            (z?10 Int) (y?11 Int) (a?12 Int))
         (and (<= (+ (- c?7) 1) 0)
                (= (+ a?12 (- x?9) (- uninterp?3) uninterp?2) 0)
                (<= (+ (- k?8) c?7 1) 0) (= (+ |c'?4| (- c?7) -1) 0)
                (= (+ |y'?5| (- uninterp?1)) 0)
                (= (+ |x'?6| (- a?12) (- uninterp?2)) 0)
                (= term_to_project_onto4 c?7) (= term_to_project_onto3 k?8)
                (= term_to_project_onto2 x?9) (= term_to_project_onto1 z?10)
                (= term_to_project_onto0 y?11) (= term_to_project_onto a?12))))
(check-sat)
