(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|i1'?1_realified?1| Real) (|k'?2_realified?2| Real)
            (i1?3_realified?3 Real) (k?4_realified?4 Real)
            (n1?5_realified?5 Real))
         (and (<= (- i1?3_realified?3) 0) (<= (- k?4_realified?4) 0)
                (<= (+ (- n1?5_realified?5) i1?3_realified?3 1) 0)
                (= (+ |i1'?1_realified?1| (- i1?3_realified?3) -1) 0)
                (= (+ |k'?2_realified?2| (- k?4_realified?4) -1) 0)
                (= (+ term_to_project_onto1 (- i1?3_realified?3)) 0)
                (= (+ term_to_project_onto0 (- k?4_realified?4)) 0)
                (= (+ term_to_project_onto (- n1?5_realified?5)) 0))))
(check-sat)