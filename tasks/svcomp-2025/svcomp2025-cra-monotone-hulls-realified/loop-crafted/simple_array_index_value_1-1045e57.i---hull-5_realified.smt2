            (index?5_realified?5 Real) (remainder_realified?6 Real)
            (remainder_realified?7 Real) (quotient_realified?8 Real)
            (quotient_realified?9 Real))
         (and (<= (- index?5_realified?5) 0)
                (<= (+ index?5_realified?5 -999) 0)
                (or (and (= (ite (and (<= (- index?5_realified?5) 0)
                                        (<= (- index?5_realified?5) 0))
