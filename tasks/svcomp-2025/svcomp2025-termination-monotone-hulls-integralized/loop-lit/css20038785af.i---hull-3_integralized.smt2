(declare-const term_to_project_onto_integralized Int)
(declare-const term_to_project_onto1_integralized Int)
(declare-const term_to_project_onto2_integralized Int)
(declare-const term_to_project_onto0_integralized Int)
(assert (exists
         ((|tmp'?1?1| Int) (|k'?2?2| Int) (|j'?3?3| Int) (|i'?4?4| Int)
            (phi_tmp?5?5 Int) (phi_tmp?6?6 Int) (phi_tmp?7?7 Int)
            (tmp?8?8 Int) (j?9?9 Int) (i?10?10 Int) (k?11?11 Int))
         (and (<= (+ (- i?10?10) 1) 0) (<= (+ i?10?10 -999999) 0)
                (or (and (<= (+ (- k?11?11) (- i?10?10) 1) 0)
                           (or (and (<= (+ k?11?11 i?10?10 -2) 0)
                                      (or (and (<= (+ i?10?10 1) 0)
                                                 (= (- phi_tmp?7?7) 0))
                                            (and (<= (- i?10?10) 0)
                                                   (= (+ (- phi_tmp?7?7) 1) 0)))
                                      (= (+ (- phi_tmp?6?6) phi_tmp?7?7) 0))
                                 (and (<= (+ (- k?11?11) (- i?10?10) 3) 0)
                                        (= (- phi_tmp?6?6) 0)))
                           (= (+ (- phi_tmp?5?5) phi_tmp?6?6) 0))
                      (and (<= (+ k?11?11 i?10?10) 0) (= (- phi_tmp?5?5) 0)))
                (or (< phi_tmp?5?5 0) (< (- phi_tmp?5?5) 0))
                (= (+ |tmp'?1?1| (- phi_tmp?5?5)) 0)
                (= (+ |k'?2?2| (- k?11?11) 1) 0)
                (= (+ (- j?9?9) |j'?3?3| (- k?11?11)) 0)
                (= (+ |i'?4?4| (- i?10?10) -1) 0)
                (= (+ term_to_project_onto2_integralized
                        (- (+ i?10?10 (- |i'?4?4|)))) 0)
                (= (+ term_to_project_onto1_integralized
                        (- (+ j?9?9 (- |j'?3?3|)))) 0)
                (= (+ term_to_project_onto0_integralized
                        (- (+ k?11?11 (- |k'?2?2|)))) 0)
                (= (+ term_to_project_onto_integralized
                        (- (+ tmp?8?8 (- |tmp'?1?1|)))) 0))))