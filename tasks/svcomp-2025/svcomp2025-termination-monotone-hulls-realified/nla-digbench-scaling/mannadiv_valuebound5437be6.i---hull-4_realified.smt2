                (= (+ (+ y3?9_realified?9 (- |y3'?2_realified?2|))
                        (+ y2?8_realified?8 (- |y2'?3_realified?3|))) 0)
                (= (+ (+ y3?9_realified?9 (- |y3'?2_realified?2|))
                        (+ y2?8_realified?8 (- |y2'?3_realified?3|))
                        (+ y1?7_realified?7 (- |y1'?4_realified?4|))) 0)
                (= (+ x1?11_realified?11 (- x1?11_realified?11)) 0)
                (= (+ term_to_project_onto3 (- y1?7_realified?7)) 0)
                (= (+ term_to_project_onto2 (- y2?8_realified?8)) 0)
                (= (+ term_to_project_onto1 (- y3?9_realified?9)) 0)
                (= (+ term_to_project_onto0 (- x1?11_realified?11)) 0)
