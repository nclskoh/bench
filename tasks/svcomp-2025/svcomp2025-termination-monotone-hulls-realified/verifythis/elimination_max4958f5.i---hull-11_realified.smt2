(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|y'?1_realified?1| Real) (|x'?2_realified?2| Real)
            (tr?3_realified?3 Real) (tr?4_realified?4 Real)
            (phi_y?5_realified?5 Real) (phi_x?6_realified?6 Real)
            (tr?7_realified?7 Real) (tr?8_realified?8 Real)
            (y?9_realified?9 Real) (x?10_realified?10 Real))
         (and (<= (- x?10_realified?10) 0)
                (<= (+ (- y?9_realified?9) x?10_realified?10 1) 0)
                (or (and (<= (+ (- tr?7_realified?7) tr?8_realified?8 1) 0)
                           (= (+ (- phi_x?6_realified?6) x?10_realified?10) 0)
                           (= (+ (- phi_y?5_realified?5) y?9_realified?9 -1) 0))
                      (and (<= (+ (- tr?3_realified?3) tr?4_realified?4) 0)
                             (= (+ (- phi_x?6_realified?6) x?10_realified?10
                                     1) 0)
                             (= (+ (- phi_y?5_realified?5) y?9_realified?9) 0)))
                (= (+ |y'?1_realified?1| (- phi_y?5_realified?5)) 0)
                (= (+ |x'?2_realified?2| (- phi_x?6_realified?6)) 0)
                (= (+ term_to_project_onto0 (- |y'?1_realified?1|)) 0)
                (= (+ term_to_project_onto (- |x'?2_realified?2|)) 0))))
(check-sat)