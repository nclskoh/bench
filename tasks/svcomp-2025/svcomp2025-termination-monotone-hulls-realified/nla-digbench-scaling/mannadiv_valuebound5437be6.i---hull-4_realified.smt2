            (phi_y2?5_realified?5 Real) (phi_y1?6_realified?6 Real)
            (y1?7_realified?7 Real) (y2?8_realified?8 Real)
            (y3?9_realified?9 Real) (x2?10_realified?10 Real)
            (x1?11_realified?11 Real))
