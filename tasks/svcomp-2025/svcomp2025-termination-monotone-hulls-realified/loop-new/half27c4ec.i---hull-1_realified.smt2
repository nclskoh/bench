                (= (+ |n'?1_realified?1| (- phi_n?3_realified?3)) 0)
                (= (+ |i'?2_realified?2| (- i?5_realified?5) -1) 0)
                (= (+ term_to_project_onto1 (- i?5_realified?5)) 0)
                (= (+ term_to_project_onto0 (- n?4_realified?4)) 0)
                (= (+ term_to_project_onto (- k?6_realified?6)) 0)
                (= (- i?5_realified?5) (+ (* 2 quotient_realified?10)
