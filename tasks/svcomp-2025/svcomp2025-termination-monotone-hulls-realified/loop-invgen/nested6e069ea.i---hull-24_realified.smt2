(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|i'?1_realified?1| Real) (|k'?2_realified?2| Real)
            (|tmp'?3_realified?3| Real) (|j'?4_realified?4| Real)
            (K?5_realified?5 Real) (|tmp'?6_realified?6| Real)
            (|j'?7_realified?7| Real) (|k'?8_realified?8| Real)
            (tmp?9_realified?9 Real) (j?10_realified?10 Real)
            (i?11_realified?11 Real) (k?12_realified?12 Real)
            (n?13_realified?13 Real))
         (and (<= (- i?11_realified?11) 0)
                (<= (+ (- n?13_realified?13) i?11_realified?11 1) 0)
                (= (+ (- |j'?4_realified?4|) K?5_realified?5
