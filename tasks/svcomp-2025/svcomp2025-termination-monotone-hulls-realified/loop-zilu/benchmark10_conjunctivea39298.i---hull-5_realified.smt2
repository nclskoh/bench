(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|c'?1_realified?1| Real) (|i'?2_realified?2| Real)
            (c?3_realified?3 Real) (i?4_realified?4 Real))
         (and (<= (- c?3_realified?3) 0) (<= (- i?4_realified?4) 0)
                (<= (+ i?4_realified?4 -99) 0) (<= (- i?4_realified?4) 0)
                (= (+ |c'?1_realified?1| (- i?4_realified?4)
                        (- c?3_realified?3)) 0)
                (= (+ |i'?2_realified?2| (- i?4_realified?4) -1) 0)
