(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|y'?1| Int) (|x'?2| Int) (y?3 Int) (x?4 Int) (j?5 Int) (i?6 Int))
         (and (<= (- y?3) 0) (<= (- x?4) 0) (<= (- j?5) 0) (<= (- i?6) 0)
                (<= (+ (- i?6) x?4 1) 0) (= (+ |y'?1| (- j?5) (- y?3)) 0)
                (= (+ |x'?2| (- x?4) -1) 0)
                (= term_to_project_onto2 (+ x?4 (- |x'?2|)))
                (= term_to_project_onto1 (+ y?3 (- |y'?1|)))
                (= term_to_project_onto0 (+ i?6 (- i?6)))
                (= term_to_project_onto (+ j?5 (- j?5))))))
(check-sat)
