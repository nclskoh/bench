(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|y'?1_realified?1| Real) (|x'?2_realified?2| Real)
            (phi_y?3_realified?3 Real) (phi_x?4_realified?4 Real)
            (y?5_realified?5 Real) (x?6_realified?6 Real))
         (and (<= (+ y?5_realified?5 x?6_realified?6 2) 0)
                (or (and (<= x?6_realified?6 0)
                           (= (+ (- phi_x?4_realified?4) x?6_realified?6) 0)
                           (= (+ (- phi_y?3_realified?3) y?5_realified?5 1) 0))
                      (and (<= (+ (- x?6_realified?6) 1) 0)
                             (= (+ (- phi_x?4_realified?4) x?6_realified?6 1) 0)
                             (= (+ (- phi_y?3_realified?3) y?5_realified?5) 0)))
                (= (+ |y'?1_realified?1| (- phi_y?3_realified?3)) 0)
                (= (+ |x'?2_realified?2| (- phi_x?4_realified?4)) 0)
                (= (+ term_to_project_onto0 (- y?5_realified?5)) 0)
                (= (+ term_to_project_onto (- x?6_realified?6)) 0))))
(check-sat)