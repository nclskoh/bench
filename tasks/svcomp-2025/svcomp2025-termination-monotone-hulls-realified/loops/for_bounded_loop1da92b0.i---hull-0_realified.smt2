(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|y'?1_realified?1| Real) (|x'?2_realified?2| Real)
            (|i'?3_realified?3| Real) (havoc?4_realified?4 Real)
            (x?5_realified?5 Real) (y?6_realified?6 Real)
            (i?7_realified?7 Real) (n?8_realified?8 Real))
         (and (<= (- i?7_realified?7) 0) (<= (+ (- n?8_realified?8) 1) 0)
                (= (+ (- x?5_realified?5) y?6_realified?6) 0)
                (<= (+ (- n?8_realified?8) i?7_realified?7 1) 0)
                (= (+ x?5_realified?5 (- y?6_realified?6)) 0)
                (or (<= (+ havoc?4_realified?4 1) 0)
                      (<= (+ (- havoc?4_realified?4) 1) 0))
                (or (<= (+ havoc?4_realified?4 x?5_realified?5
                             (- y?6_realified?6) 1) 0)
                      (<= (+ (- havoc?4_realified?4) (- x?5_realified?5)
                               y?6_realified?6 1) 0))
                (= (+ |y'?1_realified?1| (- havoc?4_realified?4)) 0)
                (= (+ |x'?2_realified?2| (- havoc?4_realified?4)
                        (- x?5_realified?5) y?6_realified?6) 0)
                (= (+ |i'?3_realified?3| (- i?7_realified?7) -1) 0)
                (= (+ term_to_project_onto2 (- i?7_realified?7)) 0)
                (= (+ term_to_project_onto1 (- x?5_realified?5)) 0)
                (= (+ term_to_project_onto0 (- y?6_realified?6)) 0)
                (= (+ term_to_project_onto (- n?8_realified?8)) 0))))
(check-sat)