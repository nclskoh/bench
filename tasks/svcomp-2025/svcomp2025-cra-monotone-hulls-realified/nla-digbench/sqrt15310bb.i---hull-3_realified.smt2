(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((uninterp?1_realified?1 Real) (uninterp?2_realified?2 Real)
            (|t'?3_realified?3| Real) (|s'?4_realified?4| Real)
            (|a'?5_realified?5| Real) (n?6_realified?6 Real)
            (s?7_realified?7 Real) (a?8_realified?8 Real)
            (t?9_realified?9 Real))
         (and (<= (+ (- s?7_realified?7) 1) 0) (<= (- a?8_realified?8) 0)
                (<= (+ (- t?9_realified?9) 1) 0)
                (= (+ (- t?9_realified?9) (* 2 a?8_realified?8) 1) 0)
                (= (+ t?9_realified?9 (* -2 a?8_realified?8) -1) 0)
                (= (+ (- uninterp?2_realified?2) (* -2 a?8_realified?8)
                        s?7_realified?7 -1) 0)
                (= (+ uninterp?1_realified?1 (* 2 t?9_realified?9)
                        (* -4 s?7_realified?7) 1) 0)
                (<= (+ (- n?6_realified?6) s?7_realified?7) 0)
                (= (+ |t'?3_realified?3| (- t?9_realified?9) -2) 0)
                (= (+ |s'?4_realified?4| (- t?9_realified?9)
                        (- s?7_realified?7) -2) 0)
                (= (+ |a'?5_realified?5| (- a?8_realified?8) -1) 0)
                (<= (+ 1 (- uninterp?1_realified?1)) 0)
                (<= (+ t?9_realified?9 (- uninterp?1_realified?1)) 0)
                (<= (+ t?9_realified?9 (- uninterp?1_realified?1)) 0)
                (<= (- uninterp?2_realified?2) 0)
                (= (+ term_to_project_onto2 (- n?6_realified?6)) 0)
                (= (+ term_to_project_onto1 (- s?7_realified?7)) 0)
                (= (+ term_to_project_onto0 (- a?8_realified?8)) 0)
                (= (+ term_to_project_onto (- t?9_realified?9)) 0))))
(check-sat)