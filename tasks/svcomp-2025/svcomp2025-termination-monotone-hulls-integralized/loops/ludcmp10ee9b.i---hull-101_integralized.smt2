(declare-const term_to_project_onto_integralized Int)
(declare-const term_to_project_onto1_integralized Int)
(declare-const term_to_project_onto2_integralized Int)
(declare-const term_to_project_onto0_integralized Int)
(assert (exists
         ((|w'?1_integralized?1| Int) (tr?2_integralized?2 Int)
            (|j'?3?3| Int) (K?4?4 Int) (|i'?5?5| Int) (|j'?6?6| Int)
            (|w'?7_integralized?7| Int) (w?8_integralized?8 Int) (j?9?9 Int)
            (i?10?10 Int) (n?11?11 Int))
         (and (<= (+ (- i?10?10) 1) 0) (<= (+ (- n?11?11) i?10?10) 0)
                (= (+ (- |j'?3?3|) K?4?4) 0)
                (or (and (= K?4?4 0)
                           (= (+ (- |w'?1_integralized?1|)
                                   tr?2_integralized?2) 0) (= (- |j'?3?3|) 0))
                      (and (<= (+ (- K?4?4) 1) 0) (<= (+ (- i?10?10) 1) 0)
                             (<= (+ (- |j'?3?3|) 1) 0)
                             (<= (+ |j'?3?3| (- i?10?10)) 0)))
                (<= (- K?4?4) 0) (<= (- |j'?3?3|) 0) (<= (+ (- i?10?10) 1) 0)
                (<= (+ (- |j'?3?3|) i?10?10) 0)
                (= (+ |w'?7_integralized?7| (- |w'?1_integralized?1|)) 0)
                (= (+ |j'?6?6| (- |j'?3?3|)) 0)
                (= (+ |i'?5?5| (- i?10?10) -1) 0)
                (= (+ (+ n?11?11 (- n?11?11)) (- (+ i?10?10 (- |i'?5?5|)))) 0)
                (= (+ n?11?11 (- n?11?11)) 0)
                (= (+ term_to_project_onto2_integralized (- i?10?10)) 0)
                (= (+ term_to_project_onto1_integralized (- j?9?9)) 0)
                (= (+ term_to_project_onto0_integralized
                        (- w?8_integralized?8)) 0)
                (= (+ term_to_project_onto_integralized (- n?11?11)) 0))))
(check-sat)