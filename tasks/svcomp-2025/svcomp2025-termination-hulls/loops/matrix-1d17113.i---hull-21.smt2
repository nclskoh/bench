(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(assert (exists
         ((|j'?1| Int) (|k'?2| Int) (K?3 Int) (|k'?4| Int) (N_LIN?5 Int)
            (k?6 Int) (N_COL?7 Int) (j?8 Int))
         (and (<= (+ (- N_LIN?5) 1) 0) (<= (+ (- N_COL?7) 1) 0)
                (<= (- j?8) 0) (= (+ (- N_COL?7) 1) 0)
                (= (+ N_COL?7 (- N_LIN?5)) 0) (<= (+ j?8 (- N_COL?7) 1) 0)
                (= (+ (- |k'?2|) K?3) 0)
                (or (and (= K?3 0) (= (- |k'?2|) 0))
                      (and (<= (+ (- K?3) 1) 0) (= (+ N_LIN?5 -1) 0)
                             (= (+ |k'?2| -1) 0) (= (+ N_LIN?5 -1) 0)))
                (<= (- K?3) 0) (<= (+ (- N_LIN?5) 1) 0) (<= (- |k'?2|) 0)
                (= (+ (- N_LIN?5) 1) 0) (<= (+ (- |k'?2|) N_LIN?5) 0)
                (= (+ |k'?4| (- |k'?2|)) 0) (= (+ |j'?1| (- j?8) -1) 0)
                (= term_to_project_onto2 (+ j?8 (- |j'?1|)))
                (= term_to_project_onto1 (+ k?6 (- |k'?4|)))
                (= term_to_project_onto0 (+ N_COL?7 (- N_COL?7)))
                (= term_to_project_onto (+ N_LIN?5 (- N_LIN?5))))))
(check-sat)
