(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|sum'?1_realified?1| Real) (|i'?2_realified?2| Real)
            (i?3_realified?3 Real) (n?4_realified?4 Real)
            (sum?5_realified?5 Real))
         (and (<= (- i?3_realified?3) 0) (<= (- n?4_realified?4) 0)
                (<= (- sum?5_realified?5) 0)
                (<= (+ (- n?4_realified?4) i?3_realified?3 1) 0)
                (= (+ |sum'?1_realified?1| (- sum?5_realified?5)
                        (- i?3_realified?3)) 0)
                (= (+ |i'?2_realified?2| (- i?3_realified?3) -1) 0)
                (= (+ term_to_project_onto1 (- i?3_realified?3)) 0)
                (= (+ term_to_project_onto0 (- sum?5_realified?5)) 0)
                (= (+ term_to_project_onto (- n?4_realified?4)) 0))))
(check-sat)