(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists ((|right'?1| Int) (right?2 Int) (space?3 Int) (n?4 Int))
         (and (<= (+ (- right?2) 1) 0) (<= (+ (- space?3) 1) 0)
                (<= (+ (- n?4) right?2 1) 0)
                (= (+ |right'?1| (* -2 space?3) (- right?2)) 0)
                (= (+ (+ n?4 (- n?4)) (- (+ right?2 (- |right'?1|)))) 0)
                (= (+ n?4 (- n?4)) 0) (= (+ space?3 (- space?3)) 0)
                (= term_to_project_onto1 right?2)
                (= term_to_project_onto0 n?4)
                (= term_to_project_onto space?3))))
(check-sat)
