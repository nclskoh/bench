(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|i'?1_realified?1| Real) (|rh'?2_realified?2| Real)
            (tr?3_realified?3 Real) (tr?4_realified?4 Real)
            (phi_rh?5_realified?5 Real) (tr?6_realified?6 Real)
            (tr?7_realified?7 Real) (rh?8_realified?8 Real)
            (i?9_realified?9 Real) (n?10_realified?10 Real))
         (and (<= (- rh?8_realified?8) 0) (<= (+ (- i?9_realified?9) 1) 0)
                (<= (+ (- n?10_realified?10) 1) 0)
                (<= (+ (- n?10_realified?10) i?9_realified?9 1) 0)
                (or (and (<= (+ (- tr?6_realified?6) tr?7_realified?7) 0)
                           (= (+ (- phi_rh?5_realified?5) rh?8_realified?8) 0))
                      (and (<= (+ (- tr?3_realified?3) tr?4_realified?4 1) 0)
                             (= (+ (- phi_rh?5_realified?5) i?9_realified?9) 0)))
                (= (+ |i'?1_realified?1| (- i?9_realified?9) -1) 0)
                (= (+ |rh'?2_realified?2| (- phi_rh?5_realified?5)) 0)
                (= (+ (+ n?10_realified?10 (- n?10_realified?10))
                        (- (+ i?9_realified?9 (- |i'?1_realified?1|)))) 0)
                (= (+ n?10_realified?10 (- n?10_realified?10)) 0)
                (= (+ term_to_project_onto1 (- rh?8_realified?8)) 0)
                (= (+ term_to_project_onto0 (- i?9_realified?9)) 0)
                (= (+ term_to_project_onto (- n?10_realified?10)) 0))))
(check-sat)