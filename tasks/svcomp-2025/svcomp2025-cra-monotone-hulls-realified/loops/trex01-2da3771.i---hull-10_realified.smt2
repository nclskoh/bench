                (= (+ |y'?2_realified?2| (- phi_y?5_realified?5)) 0)
                (= (+ |x'?3_realified?3| (- phi_x?7_realified?7)) 0)
                (= (+ term_to_project_onto3 (- |c'?1_realified?1|)) 0)
                (= (+ term_to_project_onto2 (- |y'?2_realified?2|)) 0)
