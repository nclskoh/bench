(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|j'?1_realified?1| Real) (|i'?2_realified?2| Real)
            (j?3_realified?3 Real) (i?4_realified?4 Real))
         (and (<= (- j?3_realified?3) 0) (<= (+ j?3_realified?3 -3) 0)
                (<= (+ (- j?3_realified?3) -1) 0)
                (<= (+ (- i?4_realified?4) j?3_realified?3) 0)
                (<= (+ i?4_realified?4 (- j?3_realified?3) -3) 0)
                (<= (+ j?3_realified?3 -3) 0)
                (= (+ |j'?1_realified?1| (- j?3_realified?3) -1) 0)
                (= (+ |i'?2_realified?2| (- i?4_realified?4) -1) 0)
                (= (+ term_to_project_onto0 (- j?3_realified?3)) 0)
                (= (+ term_to_project_onto (- i?4_realified?4)) 0))))
(check-sat)