(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|tmp'?1_realified?1| Real) (|k'?2_realified?2| Real)
            (|j'?3_realified?3| Real) (|i'?4_realified?4| Real)
            (phi_tmp?5_realified?5 Real) (phi_tmp?6_realified?6 Real)
            (phi_tmp?7_realified?7 Real) (j?8_realified?8 Real)
            (i?9_realified?9 Real) (k?10_realified?10 Real))
         (and (<= (+ (- i?9_realified?9) 1) 0)
                (<= (+ i?9_realified?9 -999999) 0)
                (or (and (<= (+ (- k?10_realified?10) (- i?9_realified?9) 1) 0)
                           (or (and (<= (+ k?10_realified?10 i?9_realified?9
                                             -2) 0)
                                      (or (and (<= (+ i?9_realified?9 1) 0)
                                                 (= (- phi_tmp?7_realified?7) 0))
                                            (and (<= (- i?9_realified?9) 0)
                                                   (= (+ (- phi_tmp?7_realified?7)
                                                           1) 0)))
                                      (= (+ (- phi_tmp?6_realified?6)
                                              phi_tmp?7_realified?7) 0))
                                 (and (<= (+ (- k?10_realified?10)
                                               (- i?9_realified?9) 3) 0)
                                        (= (- phi_tmp?6_realified?6) 0)))
                           (= (+ (- phi_tmp?5_realified?5)
                                   phi_tmp?6_realified?6) 0))
                      (and (<= (+ k?10_realified?10 i?9_realified?9) 0)
                             (= (- phi_tmp?5_realified?5) 0)))
                (or (< phi_tmp?5_realified?5 0)
                      (< (- phi_tmp?5_realified?5) 0))
                (= (+ |tmp'?1_realified?1| (- phi_tmp?5_realified?5)) 0)
                (= (+ |k'?2_realified?2| (- k?10_realified?10) 1) 0)
                (= (+ (- j?8_realified?8) |j'?3_realified?3|
                        (- k?10_realified?10)) 0)
                (= (+ |i'?4_realified?4| (- i?9_realified?9) -1) 0)
                (= (+ term_to_project_onto2 (- |tmp'?1_realified?1|)) 0)
                (= (+ term_to_project_onto1 (- |k'?2_realified?2|)) 0)
                (= (+ term_to_project_onto0 (- |j'?3_realified?3|)) 0)
                (= (+ term_to_project_onto (- |i'?4_realified?4|)) 0))))
(check-sat)