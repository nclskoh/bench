(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((phi_y?1_realified?1 Real) (|y'?2_realified?2| Real)
            (|x'?3_realified?3| Real) (y?4_realified?4 Real)
            (x?5_realified?5 Real))
         (and (<= (+ (- y?4_realified?4) 1) 0) (<= (- x?5_realified?5) 0)
                (<= (+ x?5_realified?5 -999999) 0)
                (or (and (<= (+ (- x?5_realified?5) 50000) 0)
                           (= (+ (- phi_y?1_realified?1) y?4_realified?4 1) 0))
                      (and (<= (+ x?5_realified?5 -49999) 0)
                             (= (+ (- phi_y?1_realified?1) y?4_realified?4) 0)))
                (= (+ |y'?2_realified?2| (- phi_y?1_realified?1)) 0)
                (= (+ |x'?3_realified?3| (- x?5_realified?5) -1) 0)
                (= (+ term_to_project_onto0 (- y?4_realified?4)) 0)
                (= (+ term_to_project_onto (- x?5_realified?5)) 0))))
(check-sat)