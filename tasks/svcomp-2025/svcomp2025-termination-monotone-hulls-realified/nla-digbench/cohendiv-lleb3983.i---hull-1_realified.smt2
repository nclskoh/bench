                (<= (+ 1 (- uninterp?2_realified?2)) 0)
                (<= (+ a?7_realified?7 (- uninterp?2_realified?2)) 0)
                (<= (+ y?10_realified?10 (- uninterp?2_realified?2)) 0)
                (= (+ term_to_project_onto4 (- a?7_realified?7)) 0)
                (= (+ term_to_project_onto3 (- b?8_realified?8)) 0)
                (= (+ term_to_project_onto2 (- y?10_realified?10)) 0)
