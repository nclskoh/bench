(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|high'?1_realified?1| Real) (|mid'?2_realified?2| Real)
            (|low'?3_realified?3| Real) (low?4_realified?4 Real)
            (mid?5_realified?5 Real) (high?6_realified?6 Real))
         (and (<= (- low?4_realified?4) 0) (<= (- mid?5_realified?5) 0)
                (<= (+ (- high?6_realified?6) 1) 0)
                (= (+ high?6_realified?6 (* -2 mid?5_realified?5)
                        (- low?4_realified?4)) 0)
                (<= (+ (- mid?5_realified?5) 1) 0)
                (= (+ |high'?1_realified?1| (- high?6_realified?6) 1) 0)
                (= (+ |mid'?2_realified?2| (- mid?5_realified?5) 1) 0)
                (= (+ |low'?3_realified?3| (- low?4_realified?4) -1) 0)
                (= (+ mid?5_realified?5 (- |mid'?2_realified?2|)) 0)
                (= (+ (+ high?6_realified?6 (- |high'?1_realified?1|))
                        (- (+ mid?5_realified?5 (- |mid'?2_realified?2|)))) 0)
                (= (+ term_to_project_onto1 (- low?4_realified?4)) 0)
                (= (+ term_to_project_onto0 (- mid?5_realified?5)) 0)
                (= (+ term_to_project_onto (- high?6_realified?6)) 0))))
(check-sat)