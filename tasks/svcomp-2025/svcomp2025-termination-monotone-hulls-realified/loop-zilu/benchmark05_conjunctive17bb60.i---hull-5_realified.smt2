(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|y'?1_realified?1| Real) (|x'?2_realified?2| Real)
            (phi_y?3_realified?3 Real) (x?4_realified?4 Real)
            (n?5_realified?5 Real) (y?6_realified?6 Real))
         (and (<= (- x?4_realified?4) 0) (<= (+ (- n?5_realified?5) 1) 0)
                (<= (- y?6_realified?6) 0)
                (<= (+ (- n?5_realified?5) x?4_realified?4 1) 0)
                (or (and (<= (+ (- y?6_realified?6) x?4_realified?4 1) 0)
                           (= (+ (- phi_y?3_realified?3) y?6_realified?6) 0))
                      (and (<= (+ y?6_realified?6 (- x?4_realified?4)) 0)
                             (= (+ (- phi_y?3_realified?3) y?6_realified?6 1) 0)))
                (= (+ |y'?1_realified?1| (- phi_y?3_realified?3)) 0)
                (= (+ |x'?2_realified?2| (- x?4_realified?4) -1) 0)
                (= (+ (+ n?5_realified?5 (- n?5_realified?5))
                        (- (+ x?4_realified?4 (- |x'?2_realified?2|)))) 0)
                (= (+ n?5_realified?5 (- n?5_realified?5)) 0)
                (= (+ (+ n?5_realified?5 (- n?5_realified?5))
                        (+ y?6_realified?6 (- |y'?1_realified?1|))
                        (- (+ x?4_realified?4 (- |x'?2_realified?2|)))) 0)
                (= (+ term_to_project_onto1 (- x?4_realified?4)) 0)
                (= (+ term_to_project_onto0 (- y?6_realified?6)) 0)
                (= (+ term_to_project_onto (- n?5_realified?5)) 0))))
(check-sat)