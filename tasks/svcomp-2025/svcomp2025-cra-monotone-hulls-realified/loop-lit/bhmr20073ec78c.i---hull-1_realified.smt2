(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|b'?1_realified?1| Real) (|a'?2_realified?2| Real)
            (|i'?3_realified?3| Real) (phi_b?4_realified?4 Real)
            (phi_a?5_realified?5 Real) (havoc?6_realified?6 Real)
            (b?7_realified?7 Real) (a?8_realified?8 Real)
            (i?9_realified?9 Real) (n?10_realified?10 Real))
         (and (<= (- b?7_realified?7) 0) (<= (- a?8_realified?8) 0)
                (<= (- i?9_realified?9) 0) (<= (- n?10_realified?10) 0)
                (= (+ (* 3 i?9_realified?9) (- a?8_realified?8)
                        (- b?7_realified?7)) 0)
                (<= (+ (- n?10_realified?10) i?9_realified?9 1) 0)
                (or (and (= havoc?6_realified?6 0)
                           (= (+ (- phi_a?5_realified?5) a?8_realified?8 2) 0)
                           (= (+ (- phi_b?4_realified?4) b?7_realified?7 1) 0))
                      (and (or (< havoc?6_realified?6 0)
                                 (< (- havoc?6_realified?6) 0))
                             (= (+ (- phi_a?5_realified?5) a?8_realified?8 1) 0)
                             (= (+ (- phi_b?4_realified?4) b?7_realified?7 2) 0)))
                (= (+ |b'?1_realified?1| (- phi_b?4_realified?4)) 0)
                (= (+ |a'?2_realified?2| (- phi_a?5_realified?5)) 0)
                (= (+ |i'?3_realified?3| (- i?9_realified?9) -1) 0)
                (= (+ term_to_project_onto1
                        (- (+ |i'?3_realified?3| (- i?9_realified?9)))) 0)
                (= (+ term_to_project_onto0
                        (- (+ |a'?2_realified?2| (- a?8_realified?8)))) 0)
                (= (+ term_to_project_onto
                        (- (+ |b'?1_realified?1| (- b?7_realified?7)))) 0))))
(check-sat)