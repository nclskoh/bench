                (<= (+ (- k?9_realified?9) c?8_realified?8 1) 0)
                (= (+ |tmp'?3_realified?3| (- counter?12_realified?12)) 0)
                (= (+ |c'?4_realified?4| (- c?8_realified?8) -1) 0)
                (= (+ |y'?5_realified?5| (- uninterp?2_realified?2)) 0)
                (= (+ |x'?6_realified?6| (- uninterp?1_realified?1) -1) 0)
                (= (+ |counter'?7_realified?7| (- counter?12_realified?12) -1) 0)
                (= (+ term_to_project_onto5 (- |tmp'?3_realified?3|)) 0)
                (= (+ term_to_project_onto4 (- |c'?4_realified?4|)) 0)
                (= (+ term_to_project_onto3 (- |y'?5_realified?5|)) 0)
                (= (+ term_to_project_onto2 (- |x'?6_realified?6|)) 0)
                (= (+ term_to_project_onto1 (- |counter'?7_realified?7|)) 0)
                (= (+ term_to_project_onto0 (- k?9_realified?9)) 0)
                (= (+ term_to_project_onto (- z?11_realified?11)) 0))))
