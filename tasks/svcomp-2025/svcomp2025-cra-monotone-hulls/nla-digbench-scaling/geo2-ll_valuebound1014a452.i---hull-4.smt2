(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((uninterp?1 Int) (uninterp?2 Int) (|c'?3| Int) (|y'?4| Int)
            (|x'?5| Int) (c?6 Int) (x?7 Int) (k?8 Int) (z?9 Int))
         (and (<= (+ (- c?6) 1) 0) (<= (- k?8) 0) (<= (- z?9) 0)
                (= (+ (- x?7) (- uninterp?2) uninterp?1 1) 0)
                (<= (+ (- k?8) c?6 1) 0) (= (+ |c'?3| (- c?6) -1) 0)
                (= (+ |y'?4| (- uninterp?2)) 0)
                (= (+ |x'?5| (- uninterp?1) -1) 0)
                (= term_to_project_onto3 |c'?3|)
                (= term_to_project_onto2 |y'?4|)
                (= term_to_project_onto1 |x'?5|)
                (= term_to_project_onto0 k?8) (= term_to_project_onto z?9))))
(check-sat)
