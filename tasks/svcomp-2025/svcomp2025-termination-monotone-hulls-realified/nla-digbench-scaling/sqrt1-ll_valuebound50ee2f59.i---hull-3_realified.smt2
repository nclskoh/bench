(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((uninterp?1_realified?1 Real) (uninterp?2_realified?2 Real)
            (|t'?3_realified?3| Real) (|s'?4_realified?4| Real)
            (|a'?5_realified?5| Real) (s?6_realified?6 Real)
            (a?7_realified?7 Real) (t?8_realified?8 Real)
            (n?9_realified?9 Real))
         (and (<= (+ (- s?6_realified?6) 1) 0) (<= (- a?7_realified?7) 0)
                (<= (+ (- t?8_realified?8) 1) 0) (<= (- n?9_realified?9) 0)
                (= (+ (- t?8_realified?8) (* 2 a?7_realified?7) 1) 0)
                (= (+ t?8_realified?8 (* -2 a?7_realified?7) -1) 0)
                (= (+ (- uninterp?2_realified?2) (* -2 a?7_realified?7)
                        s?6_realified?6 -1) 0)
                (= (+ uninterp?1_realified?1 (* 2 t?8_realified?8)
                        (* -4 s?6_realified?6) 1) 0)
                (<= (+ (- n?9_realified?9) s?6_realified?6) 0)
                (= (+ |t'?3_realified?3| (- t?8_realified?8) -2) 0)
                (= (+ |s'?4_realified?4| (- t?8_realified?8)
                        (- s?6_realified?6) -2) 0)
                (= (+ |a'?5_realified?5| (- a?7_realified?7) -1) 0)
                (<= (+ 1 (- uninterp?1_realified?1)) 0)
                (<= (+ t?8_realified?8 (- uninterp?1_realified?1)) 0)
                (<= (+ t?8_realified?8 (- uninterp?1_realified?1)) 0)
                (<= (- uninterp?2_realified?2) 0)
                (= (+ term_to_project_onto2
                        (- (+ a?7_realified?7 (- |a'?5_realified?5|)))) 0)
                (= (+ term_to_project_onto1
                        (- (+ s?6_realified?6 (- |s'?4_realified?4|)))) 0)
                (= (+ term_to_project_onto0
                        (- (+ t?8_realified?8 (- |t'?3_realified?3|)))) 0)
                (= (+ term_to_project_onto
                        (- (+ n?9_realified?9 (- n?9_realified?9)))) 0))))
(check-sat)