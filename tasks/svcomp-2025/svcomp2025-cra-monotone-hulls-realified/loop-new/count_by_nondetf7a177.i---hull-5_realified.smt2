(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|j'?1_realified?1| Real) (|k'?2_realified?2| Real)
            (|i'?3_realified?3| Real) (havoc?4_realified?4 Real)
            (k?5_realified?5 Real) (i?6_realified?6 Real))
         (and (<= (- k?5_realified?5) 0) (<= (- i?6_realified?6) 0)
                (<= (+ i?6_realified?6 -999999) 0)
                (<= (+ (- havoc?4_realified?4) 1) 0)
                (<= (+ havoc?4_realified?4 -999999) 0)
                (= (+ |j'?1_realified?1| (- havoc?4_realified?4)) 0)
                (= (+ |k'?2_realified?2| (- k?5_realified?5) -1) 0)
                (= (+ |i'?3_realified?3| (- havoc?4_realified?4)
                        (- i?6_realified?6)) 0)
                (= (+ term_to_project_onto1 (- |j'?1_realified?1|)) 0)
                (= (+ term_to_project_onto0 (- |k'?2_realified?2|)) 0)
                (= (+ term_to_project_onto (- |i'?3_realified?3|)) 0))))
(check-sat)