                                   (<= (+ (- tr?2_realified?2) 1) 0))))
                (= (+ |index'?1_realified?1| (- index?5_realified?5) -1) 0)
                (= (+ term_to_project_onto (- |index'?1_realified?1|)) 0)
                (= (- index?5_realified?5) (+ (* 2 quotient_realified?9)
