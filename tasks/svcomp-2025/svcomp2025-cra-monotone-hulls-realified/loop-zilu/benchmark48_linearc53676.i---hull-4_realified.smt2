(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|k'?1_realified?1| Real) (|i'?2_realified?2| Real)
            (j?3_realified?3 Real) (i?4_realified?4 Real)
            (k?5_realified?5 Real))
         (and (<= (+ (- k?5_realified?5) 1) 0)
                (<= (+ (- j?3_realified?3) i?4_realified?4 1) 0)
                (= (+ |k'?1_realified?1| (- k?5_realified?5) -1) 0)
                (= (+ |i'?2_realified?2| (- i?4_realified?4) -1) 0)
                (= (+ term_to_project_onto1 (- |k'?1_realified?1|)) 0)
                (= (+ term_to_project_onto0 (- |i'?2_realified?2|)) 0)
                (= (+ term_to_project_onto (- j?3_realified?3)) 0))))
(check-sat)