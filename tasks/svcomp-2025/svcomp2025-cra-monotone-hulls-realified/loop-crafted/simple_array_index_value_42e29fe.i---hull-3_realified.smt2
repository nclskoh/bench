(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|tmp'?1_realified?1| Real) (|loop_entered'?2_realified?2| Real)
            (|index2'?3_realified?3| Real) (|index1'?4_realified?4| Real)
            (tr?5_realified?5 Real) (tr?6_realified?6 Real)
            (phi_tmp?7_realified?7 Real) (phi_tmp?8_realified?8 Real)
            (loop_entered?9_realified?9 Real) (tmp?10_realified?10 Real)
            (index2?11_realified?11 Real) (index1?12_realified?12 Real))
         (and (<= (- loop_entered?9_realified?9) 0)
                (<= (- index2?11_realified?11) 0)
                (<= (- index1?12_realified?12) 0)
                (<= (+ index1?12_realified?12 (- index2?11_realified?11) 1) 0)
                (or (and (<= (+ index1?12_realified?12 -99999) 0)
                           (or (and (<= (+ (- index2?11_realified?11) 100000) 0)
                                      (= (- phi_tmp?8_realified?8) 0))
                                 (and (<= (+ index2?11_realified?11 -99999) 0)
                                        (= (+ (- phi_tmp?8_realified?8) 1) 0)))
                           (= (+ (- phi_tmp?7_realified?7)
                                   phi_tmp?8_realified?8) 0))
                      (and (<= (+ (- index1?12_realified?12) 100000) 0)
                             (= (- phi_tmp?7_realified?7) 0)))
                (or (< phi_tmp?7_realified?7 0)
                      (< (- phi_tmp?7_realified?7) 0))
                (= (+ (- tr?5_realified?5) tr?6_realified?6) 0)
                (= (+ |tmp'?1_realified?1| (- phi_tmp?7_realified?7)) 0)
                (= (+ |loop_entered'?2_realified?2| -1) 0)
                (= (+ |index2'?3_realified?3| (- index2?11_realified?11) 1) 0)
                (= (+ |index1'?4_realified?4| (- index1?12_realified?12) -1) 0)
                (= (+ term_to_project_onto2 (- loop_entered?9_realified?9)) 0)
                (= (+ term_to_project_onto1 (- tmp?10_realified?10)) 0)
                (= (+ term_to_project_onto0 (- index2?11_realified?11)) 0)
                (= (+ term_to_project_onto (- index1?12_realified?12)) 0))))
(check-sat)