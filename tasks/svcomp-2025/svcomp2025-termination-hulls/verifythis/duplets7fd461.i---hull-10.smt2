(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|i'?1| Int) (|j'?2| Int) (K?3 Int) (|j'?4| Int) (n?5 Int)
            (i?6 Int))
         (and (<= (- i?6) 0) (<= (+ (- n?5) i?6 1) 0)
                (= (+ (- |j'?2|) K?3 i?6 1) 0)
                (or (and (= K?3 0) (= (+ (- |j'?2|) i?6 1) 0))
                      (and (<= (+ (- K?3) 1) 0) (<= (- i?6) 0)
                             (<= (+ (- n?5) i?6 2) 0) (<= (+ (- |j'?2|) 2) 0)
                             (<= (+ |j'?2| (- n?5)) 0))) (<= (- K?3) 0)
                (<= (+ (- |j'?2|) 1) 0) (<= (+ (- n?5) 1) 0)
                (<= (+ (- |j'?2|) n?5) 0) (= (+ |j'?4| (- |j'?2|)) 0)
                (= (+ |i'?1| (- i?6) -1) 0) (= term_to_project_onto1 |i'?1|)
                (= term_to_project_onto0 |j'?4|) (= term_to_project_onto n?5))))
(check-sat)
