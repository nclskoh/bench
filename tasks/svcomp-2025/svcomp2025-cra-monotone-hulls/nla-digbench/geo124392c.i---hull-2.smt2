(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((uninterp?1 Int) (uninterp?2 Int) (|c'?3| Int) (|y'?4| Int)
            (|x'?5| Int) (c?6 Int) (k?7 Int) (x?8 Int) (y?9 Int) (z?10 Int))
         (and (<= (+ (- c?6) 1) 0) (= (+ (- y?9) uninterp?2 (- x?8) 1) 0)
                (<= (+ (- k?7) c?6 1) 0) (= (+ |c'?3| (- c?6) -1) 0)
                (= (+ |y'?4| (- uninterp?1)) 0)
                (= (+ |x'?5| (- uninterp?2) -1) 0)
                (= term_to_project_onto3 c?6) (= term_to_project_onto2 k?7)
                (= term_to_project_onto1 x?8) (= term_to_project_onto0 y?9)
                (= term_to_project_onto z?10))))
(check-sat)
