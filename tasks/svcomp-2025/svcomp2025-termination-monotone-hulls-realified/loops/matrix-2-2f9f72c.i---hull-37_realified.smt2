(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|k'?1_realified?1| Real) (K?2_realified?2 Real)
            (|k'?3_realified?3| Real) (|j'?4_realified?4| Real)
            (j?5_realified?5 Real) (N_LIN?6_realified?6 Real)
            (N_COL?7_realified?7 Real))
         (and (<= (- j?5_realified?5) 0) (<= (- N_LIN?6_realified?6) 0)
                (<= (- N_COL?7_realified?7) 0)
                (<= (+ (- N_COL?7_realified?7) j?5_realified?5 1) 0)
                (= (+ (- |k'?1_realified?1|) K?2_realified?2) 0)
                (or (and (= K?2_realified?2 0) (= (- |k'?1_realified?1|) 0))
                      (and (<= (+ (- K?2_realified?2) 1) 0)
                             (<= (+ (- N_LIN?6_realified?6) 1) 0)
                             (<= (+ (- |k'?1_realified?1|) 1) 0)
                             (<= (+ |k'?1_realified?1|
                                      (- N_LIN?6_realified?6)) 0)))
                (<= (- K?2_realified?2) 0) (<= (- |k'?1_realified?1|) 0)
                (<= (- N_LIN?6_realified?6) 0)
                (<= (+ (- |k'?1_realified?1|) N_LIN?6_realified?6) 0)
                (= (+ |k'?3_realified?3| (- |k'?1_realified?1|)) 0)
                (= (+ |j'?4_realified?4| (- j?5_realified?5) -1) 0)
                (= (+ term_to_project_onto2 (- |k'?3_realified?3|)) 0)
                (= (+ term_to_project_onto1 (- |j'?4_realified?4|)) 0)
                (= (+ term_to_project_onto0 (- N_LIN?6_realified?6)) 0)
                (= (+ term_to_project_onto (- N_COL?7_realified?7)) 0))))
(check-sat)