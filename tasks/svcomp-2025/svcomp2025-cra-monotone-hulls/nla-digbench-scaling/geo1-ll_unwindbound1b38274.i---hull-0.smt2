(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(assert (exists
         ((uninterp?1 Int) (uninterp?2 Int) (|tmp'?3| Int) (|c'?4| Int)
            (|y'?5| Int) (|x'?6| Int) (|counter'?7| Int) (c?8 Int) (x?9 Int)
            (y?10 Int) (tmp?11 Int) (counter?12 Int) (k?13 Int) (z?14 Int))
         (and (<= (+ (- c?8) 1) 0) (<= (- counter?12) 0)
                (<= (+ (- k?13) 1) 0) (<= (+ (- z?14) 1) 0)
                (= (+ counter?12 (- c?8) 1) 0) (<= counter?12 0)
                (= (+ (- y?10) (- x?9) uninterp?2 1) 0)
                (<= (+ (- k?13) c?8 1) 0) (= (+ |tmp'?3| (- counter?12)) 0)
                (= (+ |c'?4| (- c?8) -1) 0) (= (+ |y'?5| (- uninterp?1)) 0)
                (= (+ |x'?6| (- uninterp?2) -1) 0)
                (= (+ |counter'?7| (- counter?12) -1) 0) (<= y?10 uninterp?1)
                (<= x?9 uninterp?2)
                (= term_to_project_onto3 (+ |counter'?7| (- counter?12)))
                (= term_to_project_onto2 (+ |x'?6| (- x?9)))
                (= term_to_project_onto1 (+ |y'?5| (- y?10)))
                (= term_to_project_onto0 (+ |c'?4| (- c?8)))
                (= term_to_project_onto (+ |tmp'?3| (- tmp?11))))))
