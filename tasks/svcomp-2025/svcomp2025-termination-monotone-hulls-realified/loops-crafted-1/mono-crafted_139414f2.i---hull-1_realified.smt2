(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|y'?1_realified?1| Real) (|x'?2_realified?2| Real)
            (z?3_realified?3 Real) (y?4_realified?4 Real)
            (x?5_realified?5 Real))
         (and (= z?3_realified?3 0) (<= (- y?4_realified?4) 0)
                (= z?3_realified?3 0)
                (<= (+ (- y?4_realified?4) z?3_realified?3 1) 0)
                (= (+ |y'?1_realified?1| (- y?4_realified?4) 1) 0)
                (= (+ (- x?5_realified?5) |x'?2_realified?2| 1) 0)
                (= (+ term_to_project_onto1 (- x?5_realified?5)) 0)
                (= (+ term_to_project_onto0 (- y?4_realified?4)) 0)
                (= (+ term_to_project_onto (- z?3_realified?3)) 0))))
(check-sat)