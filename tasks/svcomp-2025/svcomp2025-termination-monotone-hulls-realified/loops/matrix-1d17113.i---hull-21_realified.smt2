(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|j'?1_realified?1| Real) (|k'?2_realified?2| Real)
            (K?3_realified?3 Real) (|k'?4_realified?4| Real)
            (N_LIN?5_realified?5 Real) (k?6_realified?6 Real)
            (N_COL?7_realified?7 Real) (j?8_realified?8 Real))
         (and (<= (+ (- N_LIN?5_realified?5) 1) 0)
                (<= (+ (- N_COL?7_realified?7) 1) 0)
                (<= (- j?8_realified?8) 0)
                (= (+ (- N_COL?7_realified?7) 1) 0)
                (= (+ N_COL?7_realified?7 (- N_LIN?5_realified?5)) 0)
                (<= (+ j?8_realified?8 (- N_COL?7_realified?7) 1) 0)
                (= (+ (- |k'?2_realified?2|) K?3_realified?3) 0)
                (or (and (= K?3_realified?3 0) (= (- |k'?2_realified?2|) 0))
                      (and (<= (+ (- K?3_realified?3) 1) 0)
                             (= (+ N_LIN?5_realified?5 -1) 0)
                             (= (+ |k'?2_realified?2| -1) 0)
                             (= (+ N_LIN?5_realified?5 -1) 0)))
                (<= (- K?3_realified?3) 0)
                (<= (+ (- N_LIN?5_realified?5) 1) 0)
                (<= (- |k'?2_realified?2|) 0)
                (= (+ (- N_LIN?5_realified?5) 1) 0)
                (<= (+ (- |k'?2_realified?2|) N_LIN?5_realified?5) 0)
                (= (+ |k'?4_realified?4| (- |k'?2_realified?2|)) 0)
                (= (+ |j'?1_realified?1| (- j?8_realified?8) -1) 0)
                (= (+ term_to_project_onto2
                        (- (+ j?8_realified?8 (- |j'?1_realified?1|)))) 0)
                (= (+ term_to_project_onto1
                        (- (+ k?6_realified?6 (- |k'?4_realified?4|)))) 0)
                (= (+ term_to_project_onto0
                        (- (+ N_COL?7_realified?7 (- N_COL?7_realified?7)))) 0)
                (= (+ term_to_project_onto
                        (- (+ N_LIN?5_realified?5 (- N_LIN?5_realified?5)))) 0))))
(check-sat)