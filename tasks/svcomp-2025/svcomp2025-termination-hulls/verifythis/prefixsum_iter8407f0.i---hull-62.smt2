(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|space'?1| Int) (|right'?2| Int) (K?3 Int) (|right'?4| Int)
            (right?5 Int) (space?6 Int) (n?7 Int))
         (and (<= (+ (- space?6) 1) 0)
                (<= (+ (- |right'?2|) (* 2 K?3) (* 2 space?6) -1) 0)
                (or (and (= K?3 0) (= (+ (- |right'?2|) (* 2 space?6) -1) 0))
                      (and (<= (+ (- K?3) 1) 0) (<= (+ (- space?6) 1) 0)
                             (<= (+ (- space?6) 1) 0)
                             (<= (+ (- n?7) (* 2 space?6)) 0)
                             (<= (+ (- |right'?2|) (* 2 space?6) 1) 0)
                             (<= (+ (- space?6) 1) 0)
                             (<= (+ (- n?7) |right'?2| (* -2 space?6) 1) 0)))
                (<= (- K?3) 0) (<= (+ (- |right'?2|) 1) 0)
                (<= (+ (- space?6) 1) 0) (<= (+ n?7 (- |right'?2|)) 0)
                (= (+ (ite (and (<= (- space?6) 0) (<= 0 space?6))
                           (mod space?6 2) (- (mod (- space?6) 2)))
                        (* 2 |space'?1|) (- space?6)) 0)
                (= (+ |right'?4| (- |right'?2|)) 0)
                (= term_to_project_onto1 (+ right?5 (- |right'?4|)))
                (= term_to_project_onto0 (+ space?6 (- |space'?1|)))
                (= term_to_project_onto (+ n?7 (- n?7))))))
(check-sat)
