(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|k'?1_realified?1| Real) (|j'?2_realified?2| Real)
            (k?3_realified?3 Real) (j?4_realified?4 Real)
            (remainder_realified?5 Real) (remainder_realified?6 Real)
            (quotient_realified?7 Real) (quotient_realified?8 Real))
         (and (= (ite (and (<= (- j?4_realified?4) 0)
                             (<= (- j?4_realified?4) 0))
                      remainder_realified?5 (- remainder_realified?6)) 0)
                (= (+ (- k?3_realified?3) |k'?1_realified?1| 4) 0)
                (= (+ |j'?2_realified?2| (- j?4_realified?4) 4) 0)
                (= (+ term_to_project_onto0 (- j?4_realified?4)) 0)
                (= (+ term_to_project_onto (- k?3_realified?3)) 0)
                (= (- j?4_realified?4) (+ (* 2 quotient_realified?8)
                                            remainder_realified?6))
                (<= 0 remainder_realified?6)
                (or (<= remainder_realified?6 (+ 2 -1))
                      (<= remainder_realified?6 (+ -2 -1)))
                (= j?4_realified?4 (+ (* 2 quotient_realified?7)
                                        remainder_realified?5))
                (<= 0 remainder_realified?5)
                (or (<= remainder_realified?5 (+ 2 -1))
                      (<= remainder_realified?5 (+ -2 -1))))))