(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto1 Real)
(assert (exists
         ((uninterp?1 Int) (uninterp?2 Int) (|y'?3| Int) (|x'?4| Int)
            (|v'?5| Int) (phi_y?6 Int) (phi_v?7 Int) (x?8 Int) (y?9 Int)
            (v?10 Int) (Y?11 Int) (X?12 Int))
         (and (<= (- x?8) 0) (<= (- y?9) 0)
                (= (+ (- v?10) (- X?12) (* 2 Y?11) (* -2 uninterp?2)
                        (* 2 uninterp?1)) 0) (<= (+ (- X?12) x?8) 0)
                (or (and (<= (- v?10) 0)
                           (= (+ (- phi_v?7) v?10 (* -2 X?12) (* 2 Y?11)) 0)
                           (= (+ (- phi_y?6) y?9 1) 0))
                      (and (<= (+ v?10 1) 0)
                             (= (+ (- phi_v?7) v?10 (* 2 Y?11)) 0)
                             (= (+ (- phi_y?6) y?9) 0)))
                (= (+ |y'?3| (- phi_y?6)) 0) (= (+ |x'?4| (- x?8) -1) 0)
                (= (+ |v'?5| (- phi_v?7)) 0) (<= 0 uninterp?2)
                (= (+ (+ X?12 (- X?12)) (- (+ x?8 (- |x'?4|)))) 0)
                (= (+ X?12 (- X?12)) 0)
                (= (+ (+ X?12 (- X?12)) (+ y?9 (- |y'?3|))
                        (- (+ x?8 (- |x'?4|)))) 0)
                (= term_to_project_onto3 v?10) (= term_to_project_onto2 x?8)
                (= term_to_project_onto1 y?9) (= term_to_project_onto0 X?12)
                (= term_to_project_onto Y?11))))
(check-sat)
