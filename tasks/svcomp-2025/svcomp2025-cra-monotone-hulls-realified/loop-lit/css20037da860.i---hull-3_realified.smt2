(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|tmp'?1_realified?1| Real) (|k'?2_realified?2| Real)
            (|j'?3_realified?3| Real) (|i'?4_realified?4| Real)
            (phi_tmp?5_realified?5 Real) (phi_tmp?6_realified?6 Real)
            (phi_tmp?7_realified?7 Real) (tmp?8_realified?8 Real)
            (j?9_realified?9 Real) (i?10_realified?10 Real)
            (k?11_realified?11 Real))
         (and (<= (+ (- i?10_realified?10) 1) 0)
                (<= (+ i?10_realified?10 -999999) 0)
                (or (and (<= (+ (- k?11_realified?11) (- i?10_realified?10) 1) 0)
                           (or (and (<= (+ k?11_realified?11
                                             i?10_realified?10 -2) 0)
                                      (or (and (<= (+ i?10_realified?10 1) 0)
                                                 (= (- phi_tmp?7_realified?7) 0))
                                            (and (<= (- i?10_realified?10) 0)
                                                   (= (+ (- phi_tmp?7_realified?7)
                                                           1) 0)))
                                      (= (+ (- phi_tmp?6_realified?6)
                                              phi_tmp?7_realified?7) 0))
                                 (and (<= (+ (- k?11_realified?11)
                                               (- i?10_realified?10) 3) 0)
                                        (= (- phi_tmp?6_realified?6) 0)))
                           (= (+ (- phi_tmp?5_realified?5)
                                   phi_tmp?6_realified?6) 0))
                      (and (<= (+ k?11_realified?11 i?10_realified?10) 0)
                             (= (- phi_tmp?5_realified?5) 0)))
                (or (< phi_tmp?5_realified?5 0)
                      (< (- phi_tmp?5_realified?5) 0))
                (= (+ |tmp'?1_realified?1| (- phi_tmp?5_realified?5)) 0)
                (= (+ |k'?2_realified?2| (- k?11_realified?11) 1) 0)
                (= (+ (- j?9_realified?9) |j'?3_realified?3|
                        (- k?11_realified?11)) 0)
                (= (+ |i'?4_realified?4| (- i?10_realified?10) -1) 0)
                (= (+ term_to_project_onto2 (- tmp?8_realified?8)) 0)
                (= (+ term_to_project_onto1 (- j?9_realified?9)) 0)
                (= (+ term_to_project_onto0 (- i?10_realified?10)) 0)
                (= (+ term_to_project_onto (- k?11_realified?11)) 0))))
