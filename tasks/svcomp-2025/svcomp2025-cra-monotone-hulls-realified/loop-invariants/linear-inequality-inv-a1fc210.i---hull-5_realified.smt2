(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|i'?1_realified?1| Real) (|s'?2_realified?2| Real)
            (|v'?3_realified?3| Real) (havoc?4_realified?4 Real)
            (s?5_realified?5 Real) (i?6_realified?6 Real)
            (n?7_realified?7 Real))
         (and (<= (- i?6_realified?6) 0)
                (<= (+ (- n?7_realified?7) i?6_realified?6 1) 0)
                (= (+ |i'?1_realified?1| (- i?6_realified?6) -1) 0)
                (= (+ (- havoc?4_realified?4) (- s?5_realified?5)
                        |s'?2_realified?2|) 0)
                (= (+ |v'?3_realified?3| (- havoc?4_realified?4)) 0)
                (= (+ term_to_project_onto2 (- |i'?1_realified?1|)) 0)
                (= (+ term_to_project_onto1 (- |s'?2_realified?2|)) 0)
                (= (+ term_to_project_onto0 (- |v'?3_realified?3|)) 0)
                (= (+ term_to_project_onto (- n?7_realified?7)) 0))))
(check-sat)