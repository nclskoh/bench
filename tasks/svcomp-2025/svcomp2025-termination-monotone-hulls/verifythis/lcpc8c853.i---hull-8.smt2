(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|l'?1| Int) (tr?2 Int) (tr?3 Int) (n?4 Int) (y?5 Int) (x?6 Int)
            (l?7 Int))
         (and (<= (- l?7) 0) (<= (+ (- n?4) x?6 l?7 1) 0)
                (<= (+ y?5 (- n?4) l?7 1) 0) (= (+ (- tr?2) tr?3) 0)
                (= (+ |l'?1| (- l?7) -1) 0)
                (= term_to_project_onto2 (+ l?7 (- |l'?1|)))
                (= term_to_project_onto1 (+ x?6 (- x?6)))
                (= term_to_project_onto0 (+ y?5 (- y?5)))
                (= term_to_project_onto (+ n?4 (- n?4))))))
(check-sat)
