(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(assert (exists
         ((uninterp?1 Int) (uninterp?2 Int) (uninterp?3 Int) (|c'?4| Int)
            (|y'?5| Int) (|x'?6| Int) (c?7 Int) (x?8 Int) (y?9 Int)
            (k?10 Int) (a?11 Int) (z?12 Int))
         (and (<= (+ (- c?7) 1) 0) (<= (- k?10) 0) (<= (- a?11) 0)
                (<= (- z?12) 0)
                (= (+ (- uninterp?3) (- x?8) uninterp?2 a?11) 0)
                (<= (+ (- k?10) c?7 1) 0) (= (+ |c'?4| (- c?7) -1) 0)
                (= (+ |y'?5| (- uninterp?1)) 0)
                (= (+ |x'?6| (- uninterp?2) (- a?11)) 0)
                (= term_to_project_onto1 (+ |x'?6| (- x?8)))
                (= term_to_project_onto0 (+ |y'?5| (- y?9)))
                (= term_to_project_onto (+ |c'?4| (- c?7))))))
(check-sat)
