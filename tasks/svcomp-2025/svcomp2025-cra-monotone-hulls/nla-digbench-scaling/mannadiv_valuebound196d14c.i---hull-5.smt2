(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto2 Real)
(assert (exists
         ((uninterp?1 Int) (|y3'?2| Int) (|y2'?3| Int) (|y1'?4| Int)
            (phi_y2?5 Int) (phi_y1?6 Int) (y1?7 Int) (y2?8 Int) (y3?9 Int)
            (x2?10 Int) (x1?11 Int))
         (and (<= (- y1?7) 0) (<= (- y2?8) 0) (<= (- y3?9) 0)
                (<= (- x1?11) 0) (= (+ (- x1?11) y3?9 y2?8 uninterp?1) 0)
                (or (<= (+ y3?9 1) 0) (<= (+ (- y3?9) 1) 0))
                (or (and (or (< (+ (- x2?10) y2?8 1) 0)
                               (< 0 (+ (- x2?10) y2?8 1)))
                           (= (+ (- phi_y1?6) y1?7) 0)
                           (= (+ (- phi_y2?5) y2?8 1) 0))
                      (and (= (+ (- x2?10) y2?8 1) 0)
                             (= (+ (- phi_y1?6) y1?7 1) 0) (= (- phi_y2?5) 0)))
                (= (+ |y3'?2| (- y3?9) 1) 0) (= (+ |y2'?3| (- phi_y2?5)) 0)
                (= (+ |y1'?4| (- phi_y1?6)) 0)
                (= term_to_project_onto3 |y3'?2|)
                (= term_to_project_onto2 |y2'?3|)
                (= term_to_project_onto1 |y1'?4|)
                (= term_to_project_onto0 x2?10)
                (= term_to_project_onto x1?11))))
(check-sat)
