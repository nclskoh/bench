(assert (exists
         ((|tmp'?1| Int) (|cp'?2| Int) (havoc?3 Int) (tmp?4 Int) (cp?5 Int)
            (urilen?6 Int))
         (and (<= (+ (- cp?5) 1) 0) (<= (+ (- urilen?6) 1) 0)
