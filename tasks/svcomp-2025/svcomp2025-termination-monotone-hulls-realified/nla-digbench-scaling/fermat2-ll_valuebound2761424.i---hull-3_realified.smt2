                (= (+ |r'?3_realified?3| (- phi_r?6_realified?6)) 0)
                (= (+ |v'?4_realified?4| (- phi_v?7_realified?7)) 0)
                (= (+ |u'?5_realified?5| (- phi_u?8_realified?8)) 0)
                (<= (+ 1 (- uninterp?1_realified?1)) 0)
                (<= (+ u?9_realified?9 (- uninterp?1_realified?1)) 0)
                (<= (+ u?9_realified?9 (- uninterp?1_realified?1)) 0)
                (<= (+ 1 (- uninterp?2_realified?2)) 0)
                (<= (+ v?10_realified?10 (- uninterp?2_realified?2)) 0)
                (<= (+ v?10_realified?10 (- uninterp?2_realified?2)) 0)
                (= (+ term_to_project_onto2
