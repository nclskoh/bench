(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|x'?1_realified?1| Real) (|z'?2_realified?2| Real)
            (z?3_realified?3 Real) (x?4_realified?4 Real))
         (and (<= (- z?3_realified?3) 0) (<= (- x?4_realified?4) 0)
                (<= (+ (- z?3_realified?3) 1) 0)
                (= (+ |z'?2_realified?2| (- z?3_realified?3) 1) 0)
                (= (+ |x'?1_realified?1| (- x?4_realified?4) -1) 0)
                (= (+ z?3_realified?3 (- |z'?2_realified?2|)) 0)
                (= (+ (+ z?3_realified?3 (- |z'?2_realified?2|))
                        (+ x?4_realified?4 (- |x'?1_realified?1|))) 0)
                (= (+ term_to_project_onto0 (- x?4_realified?4)) 0)
                (= (+ term_to_project_onto (- z?3_realified?3)) 0))))
(check-sat)