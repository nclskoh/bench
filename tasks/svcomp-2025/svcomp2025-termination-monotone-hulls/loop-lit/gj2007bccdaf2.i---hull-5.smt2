(assert (exists
         ((|m'?1| Int) (|x'?2| Int) (phi_m?3 Int) (havoc?4 Int) (m?5 Int)
            (n?6 Int) (x?7 Int))
         (and (<= (- m?5) 0) (<= (- x?7) 0) (<= (+ (- n?6) x?7 1) 0)
