(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto1 Real)
(assert (exists ((|sn'?1| Int) (|i'?2| Int) (sn?3 Int) (i?4 Int) (n?5 Int))
         (and (<= (- sn?3) 0) (<= (+ (- i?4) 1) 0)
                (= (+ (* -2 i?4) sn?3 2) 0) (<= (+ (- n?5) i?4) 0)
                (= (+ |sn'?1| (- sn?3) -2) 0) (= (+ |i'?2| (- i?4) -1) 0)
                (= (+ n?5 (- n?5)) 0)
                (= (+ (* 2 (+ n?5 (- n?5))) (- (+ sn?3 (- |sn'?1|)))) 0)
                (= term_to_project_onto1 i?4) (= term_to_project_onto0 sn?3)
                (= term_to_project_onto n?5))))
(check-sat)
