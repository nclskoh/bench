(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((|j'?1_realified?1| Real) (|k'?2_realified?2| Real)
            (k?3_realified?3 Real) (n?4_realified?4 Real)
            (j?5_realified?5 Real))
         (and (<= (+ (- n?4_realified?4) 1) 0) (<= (- j?5_realified?5) 0)
                (<= (+ j?5_realified?5 (- n?4_realified?4) 1) 0)
                (= (+ |j'?1_realified?1| (- j?5_realified?5) -1) 0)
                (= (+ (- k?3_realified?3) |k'?2_realified?2| 1) 0)
                (= (+ term_to_project_onto1 (- k?3_realified?3)) 0)
                (= (+ term_to_project_onto0 (- n?4_realified?4)) 0)
                (= (+ term_to_project_onto (- j?5_realified?5)) 0))))
