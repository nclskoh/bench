(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto5 Real)
(declare-const term_to_project_onto4 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(assert (exists
         ((uninterp?1_realified?1 Real) (uninterp?2_realified?2 Real)
            (|yx'?3_realified?3| Real) (|xy'?4_realified?4| Real)
            (|v'?5_realified?5| Real) (|y'?6_realified?6| Real)
            (|x'?7_realified?7| Real) (phi_v?8_realified?8 Real)
            (phi_y?9_realified?9 Real) (v?10_realified?10 Real)
            (y?11_realified?11 Real) (x?12_realified?12 Real)
            (Y?13_realified?13 Real) (X?14_realified?14 Real))
         (and (<= (- y?11_realified?11) 0) (<= (- x?12_realified?12) 0)
                (<= (- Y?13_realified?13) 0) (<= (- X?14_realified?14) 0)
                (= (+ (- v?10_realified?10) (- X?14_realified?14)
                        (* 2 Y?13_realified?13) (* 2 uninterp?2_realified?2)
                        (* -2 uninterp?1_realified?1)) 0)
                (<= (+ (- X?14_realified?14) x?12_realified?12) 0)
                (or (and (<= (- v?10_realified?10) 0)
                           (= (+ (- phi_y?9_realified?9) y?11_realified?11 1) 0)
                           (= (+ (- phi_v?8_realified?8) v?10_realified?10
                                   (* -2 X?14_realified?14)
                                   (* 2 Y?13_realified?13)) 0))
                      (and (<= (+ v?10_realified?10 1) 0)
                             (= (+ (- phi_y?9_realified?9) y?11_realified?11) 0)
                             (= (+ (- phi_v?8_realified?8) v?10_realified?10
                                     (* 2 Y?13_realified?13)) 0)))
                (= (+ |yx'?3_realified?3| (- uninterp?2_realified?2)) 0)
                (= (+ |xy'?4_realified?4| (- uninterp?1_realified?1)) 0)
                (= (+ |v'?5_realified?5| (- phi_v?8_realified?8)) 0)
                (= (+ |y'?6_realified?6| (- phi_y?9_realified?9)) 0)
                (= (+ |x'?7_realified?7| (- x?12_realified?12) -1) 0)
                (<= (- uninterp?1_realified?1) 0)
                (<= (- uninterp?2_realified?2) 0)
                (= (+ term_to_project_onto5 (- |yx'?3_realified?3|)) 0)
                (= (+ term_to_project_onto4 (- |xy'?4_realified?4|)) 0)
                (= (+ term_to_project_onto3 (- |v'?5_realified?5|)) 0)
                (= (+ term_to_project_onto2 (- |y'?6_realified?6|)) 0)
                (= (+ term_to_project_onto1 (- |x'?7_realified?7|)) 0)
                (= (+ term_to_project_onto0 (- Y?13_realified?13)) 0)
                (= (+ term_to_project_onto (- X?14_realified?14)) 0))))
