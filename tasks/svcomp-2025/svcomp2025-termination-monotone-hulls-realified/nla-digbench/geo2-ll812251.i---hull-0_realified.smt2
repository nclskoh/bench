(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto0 Real)
(assert (exists
         ((uninterp?1_realified?1 Real) (uninterp?2_realified?2 Real)
            (|c'?3_realified?3| Real) (|y'?4_realified?4| Real)
            (|x'?5_realified?5| Real) (c?6_realified?6 Real)
            (k?7_realified?7 Real) (x?8_realified?8 Real)
            (z?9_realified?9 Real) (y?10_realified?10 Real))
         (and (<= (+ (- c?6_realified?6) 1) 0)
                (= (+ (- uninterp?2_realified?2) uninterp?1_realified?1
                        (- x?8_realified?8) 1) 0)
                (<= (+ (- k?7_realified?7) c?6_realified?6 1) 0)
                (= (+ |c'?3_realified?3| (- c?6_realified?6) -1) 0)
                (= (+ |y'?4_realified?4| (- uninterp?2_realified?2)) 0)
                (= (+ |x'?5_realified?5| (- uninterp?1_realified?1) -1) 0)
                (= (+ term_to_project_onto3 (- x?8_realified?8)) 0)
                (= (+ term_to_project_onto2 (- y?10_realified?10)) 0)
                (= (+ term_to_project_onto1 (- c?6_realified?6)) 0)
                (= (+ term_to_project_onto0 (- z?9_realified?9)) 0)
                (= (+ term_to_project_onto (- k?7_realified?7)) 0))))
(check-sat)