(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto3 Real)
(declare-const term_to_project_onto1 Real)
(assert (exists
         ((uninterp?1 Int) (uninterp?2 Int) (|c'?3| Int) (|y'?4| Int)
            (|x'?5| Int) (c?6 Int) (x?7 Int) (y?8 Int) (k?9 Int) (z?10 Int))
         (and (<= (+ (- c?6) 1) 0) (<= (- k?9) 0) (<= (- z?10) 0)
                (= (+ (- x?7) (- uninterp?2) uninterp?1 1) 0)
                (<= (+ (- k?9) c?6 1) 0) (= (+ |c'?3| (- c?6) -1) 0)
                (= (+ |y'?4| (- uninterp?2)) 0)
                (= (+ |x'?5| (- uninterp?1) -1) 0)
                (= term_to_project_onto3 (+ x?7 (- |x'?5|)))
                (= term_to_project_onto2 (+ y?8 (- |y'?4|)))
                (= term_to_project_onto1 (+ c?6 (- |c'?3|)))
                (= term_to_project_onto0 (+ z?10 (- z?10)))
                (= term_to_project_onto (+ k?9 (- k?9))))))
(check-sat)
