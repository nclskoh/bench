(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto2 Real)
(declare-const term_to_project_onto1 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((uninterp?1_realified?1 Real) (|tmp'?2_realified?2| Real)
            (|p'?3_realified?3| Real) (|d'?4_realified?4| Real)
            (|counter'?5_realified?5| Real) (p?6_realified?6 Real)
            (d?7_realified?7 Real) (r?8_realified?8 Real)
            (q?9_realified?9 Real) (tmp?10_realified?10 Real)
            (counter?11_realified?11 Real) (B?12_realified?12 Real)
            (A?13_realified?13 Real))
         (and (<= (+ (- p?6_realified?6) 1) 0)
                (<= (+ (- d?7_realified?7) 1) 0) (= q?9_realified?9 0)
                (<= (- counter?11_realified?11) 0)
                (<= (+ (- B?12_realified?12) 1) 0)
                (= (+ (- B?12_realified?12) 1) 0)
                (= (+ (- r?8_realified?8) A?13_realified?13) 0)
                (= q?9_realified?9 0)
                (= (+ d?7_realified?7 (- p?6_realified?6)) 0)
                (<= (+ counter?11_realified?11 -1) 0) (= q?9_realified?9 0)
                (= (+ r?8_realified?8 (- A?13_realified?13)) 0)
                (= (+ d?7_realified?7 (- uninterp?1_realified?1)) 0)
                (<= (+ (- r?8_realified?8) d?7_realified?7) 0)
                (= (+ |tmp'?2_realified?2| (- counter?11_realified?11)) 0)
                (= (+ |p'?3_realified?3| (* -2 p?6_realified?6)) 0)
                (= (+ |d'?4_realified?4| (* -2 d?7_realified?7)) 0)
                (= (+ |counter'?5_realified?5| (- counter?11_realified?11) -1) 0)
                (<= (+ 1 (- uninterp?1_realified?1)) 0)
                (<= (+ p?6_realified?6 (- uninterp?1_realified?1)) 0)
                (<= (+ B?12_realified?12 (- uninterp?1_realified?1)) 0)
                (<= (+ uninterp?1_realified?1 (- p?6_realified?6)) 0)
                (= (+ term_to_project_onto2
                        (- (+ |counter'?5_realified?5|
                                (- counter?11_realified?11)))) 0)
                (= (+ term_to_project_onto1
                        (- (+ |d'?4_realified?4| (- d?7_realified?7)))) 0)
                (= (+ term_to_project_onto0
                        (- (+ |p'?3_realified?3| (- p?6_realified?6)))) 0)
                (= (+ term_to_project_onto
                        (- (+ |tmp'?2_realified?2| (- tmp?10_realified?10)))) 0))))
(check-sat)