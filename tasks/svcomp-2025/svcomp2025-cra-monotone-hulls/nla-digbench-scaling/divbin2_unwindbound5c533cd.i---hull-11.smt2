(assert (exists
         ((|tmp'?1| Int) (|b'?2| Int) (|counter'?3| Int) (b?4 Int) (r?5 Int)
            (counter?6 Int))
         (and (<= (+ (- b?4) 1) 0) (<= (- r?5) 0) (<= (- counter?6) 0)
                (<= (+ counter?6 -4) 0) (<= (+ (- r?5) b?4) 0)
                (= (+ |tmp'?1| (- counter?6)) 0) (= (+ |b'?2| (* -2 b?4)) 0)
                (= (+ |counter'?3| (- counter?6) -1) 0)
