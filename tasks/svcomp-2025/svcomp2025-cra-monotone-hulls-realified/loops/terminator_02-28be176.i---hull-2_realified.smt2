(declare-const term_to_project_onto0 Real)
(declare-const term_to_project_onto Real)
(assert (exists
         ((|z'?1_realified?1| Real) (|x'?2_realified?2| Real)
            (phi_z?3_realified?3 Real) (phi_x?4_realified?4 Real)
            (havoc?5_realified?5 Real) (z?6_realified?6 Real)
            (x?7_realified?7 Real))
         (and (<= (- z?6_realified?6) 0) (<= (+ x?7_realified?7 -99) 0)
                (<= (+ (- z?6_realified?6) 101) 0)
                (or (and (= havoc?5_realified?5 0)
                           (= (+ (- phi_x?4_realified?4) x?7_realified?7 -1) 0)
                           (= (+ (- phi_z?3_realified?3) z?6_realified?6 -1) 0))
                      (and (or (< havoc?5_realified?5 0)
                                 (< (- havoc?5_realified?5) 0))
                             (= (+ (- phi_x?4_realified?4) x?7_realified?7 1) 0)
                             (= (+ (- phi_z?3_realified?3) z?6_realified?6) 0)))
                (= (+ |z'?1_realified?1| (- phi_z?3_realified?3)) 0)
                (= (+ |x'?2_realified?2| (- phi_x?4_realified?4)) 0)
                (= (+ term_to_project_onto0 (- z?6_realified?6)) 0)
                (= (+ term_to_project_onto (- x?7_realified?7)) 0))))
(check-sat)